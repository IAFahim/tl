<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TlGenAnalyzer>$(MSBuildThisFileDirectory)..\..\src\Tl.Gen.CSharp\bin\$(Configuration)\netstandard2.0\Tl.Gen.CSharp.dll</TlGenAnalyzer>
    <TlCompilerAnalyzer>$(MSBuildThisFileDirectory)..\..\src\Tl.Gen.CSharp\bin\$(Configuration)\netstandard2.0\Tl.Compiler.dll</TlCompilerAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
    <ProjectReference Include="..\..\src\Tl.Core\Tl.Core.csproj" />
    <None Include="$(TlGenAnalyzer)" Link="Tl.Gen.CSharp.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TlCompilerAnalyzer)" Link="Tl.Compiler.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildUnityAnalyzer" BeforeTargets="PrepareForBuild">
    <MSBuild Projects="..\..\src\Tl.Gen.CSharp\Tl.Gen.CSharp.csproj" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
  </Target>

</Project>
