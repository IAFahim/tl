{
  "schemaVersion": 1,
  "scenarios": [
    {
      "name": "bake_valid",
      "mode": "bake",
      "inputs": {
        "json": "$configDir/fixtures/alpha.json"
      },
      "options": {
        "assemblies": [
          "$testAssembly"
        ]
      },
      "expected": {
        "exitCode": 0,
        "output": {
          "path": "$out/alpha.tlb",
          "sha256": "73f2d3b186384340eeae2e872b0fc682470f4fada32495e85649963985e5cd44"
        }
      }
    },
    {
      "name": "bake_diagnostic",
      "mode": "bake",
      "inputs": {
        "json": "$configDir/fixtures/broken.json"
      },
      "options": {
        "assemblies": [
          "$testAssembly"
        ]
      },
      "expected": {
        "exitCode": 1,
        "stderrContains": [
          "[3:3] duplicate field: 'duration'"
        ],
        "absentOutputs": [
          "$out/broken.tlb"
        ]
      }
    },
    {
      "name": "cache_reuse",
      "mode": "bake",
      "inputs": {
        "json": "$configDir/fixtures/alpha.json"
      },
      "options": {
        "assemblies": [
          "$testAssembly"
        ],
        "cache": "$out/cache"
      },
      "expected": {
        "exitCode": 0,
        "runs": [
          {
            "stdoutContains": [
              "cache: miss"
            ]
          },
          {
            "stdoutContains": [
              "cache: hit"
            ]
          }
        ],
        "output": {
          "path": "$out/alpha.tlb",
          "sha256": "73f2d3b186384340eeae2e872b0fc682470f4fada32495e85649963985e5cd44"
        }
      }
    },
    {
      "name": "json_introspection",
      "mode": "json",
      "options": {
        "assemblies": [
          "$testAssembly"
        ]
      },
      "expected": {
        "exitCode": 0,
        "stdoutGolden": "$root/tools/Tl.Bake.Tests/golden/introspection.json"
      }
    },
    {
      "name": "report",
      "mode": "report",
      "inputs": {
        "tlb": "$out/alpha.tlb"
      },
      "expected": {
        "exitCode": 0,
        "stdoutContains": [
          "tlb/total-bytes: 536",
          "pair/count: 1",
          "pool/0/track-unique-count: 1",
          "pool/0/clip-unique-count: 2",
          "pool/unique-count: 3",
          "label/clip-count: 2"
        ]
      }
    },
    {
      "name": "strip",
      "mode": "strip",
      "inputs": {
        "tlb": "$out/alpha.tlb"
      },
      "expected": {
        "exitCode": 0,
        "output": {
          "path": "$out/alpha.stripped.tlb",
          "sha256": "4c410fff5e955916bd3d05b1703069fbff4c1ab3f73144368eb9a304bae7726c"
        }
      }
    },
    {
      "name": "inspect",
      "mode": "inspect",
      "inputs": {
        "tlb": "$out/alpha.tlb"
      },
      "expected": {
        "exitCode": 0,
        "stdoutContains": [
          "\"schemaVersion\": 2",
          "\"looping\": true",
          "\"duration\": 12",
          "\"slotStride\": 24",
          "\"windowEnd\": 12"
        ]
      }
    },
    {
      "name": "inspect_invalid_asset",
      "mode": "inspect",
      "inputs": {
        "tlb": "$configDir/fixtures/alpha.json"
      },
      "expected": {
        "exitCode": 3,
        "stderrContains": [
          "Asset error: TLB asset header is invalid."
        ]
      }
    },
    {
      "name": "inspect_missing_file",
      "mode": "inspect",
      "inputs": {
        "tlb": "$out/missing.tlb"
      },
      "expected": {
        "exitCode": 2,
        "stderrContains": [
          "does not exist"
        ]
      }
    },
    {
      "name": "watch_rebuild_skip_diagnostic",
      "mode": "watch",
      "inputs": {
        "initial": "$configDir/fixtures/alpha.json",
        "edits": [
          "$configDir/fixtures/alpha_edited.json",
          "$configDir/fixtures/alpha_edited.json",
          "$configDir/fixtures/broken.json"
        ]
      },
      "options": {
        "assemblies": [
          "$testAssembly"
        ],
        "debounceMs": 50,
        "timeoutSeconds": 60
      },
      "expected": {
        "events": [
          "ready",
          "rebuild",
          "rebuild",
          "skip",
          "diagnostic"
        ]
      }
    }
  ]
}