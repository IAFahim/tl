<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tl.Core\Tl.Core.csproj" />
    <ProjectReference Include="..\..\src\Tl.Gen\Tl.Gen.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <ItemGroup>
    <TimelineDefinition Include="GeneratedAotTimeline.def">
      <Namespace>Tl.Aot</Namespace>
    </TimelineDefinition>
  </ItemGroup>

  <Import Project="..\..\src\Tl.Gen\build\Tl.Gen.targets" />

</Project>
