<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>Tl.Systems.Tests</AssemblyName>
    <RootNamespace>Tl.Systems.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tl.Core\Tl.Core.csproj" />
    <ProjectReference Include="..\..\src\Tl.Gen.CSharp\Tl.Gen.CSharp.csproj" />
    <ProjectReference Include="..\..\tools\Tl.Gen.Tlb\Tl.Gen.Tlb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Shared\DomainBaker.cs" Link="Shared\DomainBaker.cs" />
    <EmbeddedResource Include="..\..\tests\Shared\DomainBaker.cs" Link="Shared\DomainBaker.cs" />
    <EmbeddedResource Include="Toolbox\Toolbox.cs" />
    <EmbeddedResource Include="KindDomain\KindDomain.cs" />
    <EmbeddedResource Include="IdleDomain\IdleDomain.cs" />
    <Compile Remove="ForceContract\**" />
    <EmbeddedResource Include="ForceContract\*.cs" />
    <Compile Remove="TwoAssembly\**" />
    <EmbeddedResource Include="TwoAssembly\*.cs" />
    <Compile Remove="Parity\**" />
    <EmbeddedResource Include="Parity\*.cs" />
    <EmbeddedResource Include="Generated\TlSystemsKinds.g.cs" />
    <EmbeddedResource Include="Generated\TlSystemsIdle.g.cs" />
    <EmbeddedResource Include="Generated\TlSystemsSnapshot.g.cs" />
    <EmbeddedResource Include="Generated\ParityGoldens.json" />
    <EmbeddedResource Include="BenchDomain\BenchShapes.cs" />
    <EmbeddedResource Include="BenchDomain\BenchS64Base.cs" />
    <EmbeddedResource Include="BenchDomain\BenchS64Consumers.cs" />
    <EmbeddedResource Include="..\..\benchmarks\KindSystems\Domain.cs" Link="KindBenchDomain\Domain.cs" />
  </ItemGroup>

</Project>
