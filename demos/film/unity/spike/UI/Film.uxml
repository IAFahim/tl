<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Film.uss" />
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement class="header">
            <ui:Label name="brand" text="Tl" class="brand" />
            <ui:VisualElement name="beat" class="beat" />
            <ui:Label name="tag" text="this film is a Tl timeline, drawn with UI Toolkit" class="tag" />
        </ui:VisualElement>
        <ui:Label name="scene" class="scene" />
        <ui:VisualElement class="bar"><ui:VisualElement name="phase" class="fill" /></ui:VisualElement>
        <ui:Label name="caption" class="caption" />
    </ui:VisualElement>
</ui:UXML>
