<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.CSharp</PackageId>
    <Authors>IAFahim</Authors>
    <Description>One-package C# installation: tl runtime plus the build-time consumer binding generator.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>timeline;ecs;burst;unity;dotnet;deterministic;baked-assets</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v1.0.0-alpha.10: tlb bakes JSON batches in parallel across all cores, byte-identical to serial (3.6x on 257 files); BakerAssemblyResolver.FromAssemblies scopes in-memory bake resolution; SIMD masks and a shared workspace cut a 20 MB bake from 71 to 60 ms. Playback surface unchanged; source, samples, and tooling byte budgets are enforced.</PackageReleaseNotes>
    <TlGenPackOutput Condition="'$(TlGenPackOutput)' == ''">..\Tl.Gen.CSharp\bin\$(Configuration)\net10.0\</TlGenPackOutput>
    <TlGenAnalyzerPackOutput Condition="'$(TlGenAnalyzerPackOutput)' == ''">..\Tl.Gen.CSharp\bin\$(Configuration)\netstandard2.0\</TlGenAnalyzerPackOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tl.Core\Tl.Core.csproj" />
    <ProjectReference Include="..\Tl.Gen.CSharp\Tl.Gen.CSharp.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="_._" Pack="true" PackagePath="lib\net10.0" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <None Include="..\Tl.Gen.CSharp\build\Tl.Gen.CSharp.targets" Pack="true" PackagePath="build\Tl.CSharp.targets;buildTransitive\Tl.CSharp.targets" />
    <None Include="$(TlGenAnalyzerPackOutput)Tl.Gen.CSharp.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
                          </ItemGroup>

  <Target Name="BuildTlCSharpAnalyzer" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="..\Tl.Gen.CSharp\Tl.Gen.CSharp.csproj"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
  </Target>

</Project>
