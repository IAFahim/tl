<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.CSharp</PackageId>
    <Authors>IAFahim</Authors>
    <Description>One-package C# installation for the tl runtime and automatic compiler.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.0-alpha.2: one-package installation for Tl.Runtime and Tl.Gen.CSharp.</PackageReleaseNotes>
    <TlGenPackOutput Condition="'$(TlGenPackOutput)' == ''">..\Tl.Gen.CSharp\bin\$(Configuration)\net10.0\</TlGenPackOutput>
    <TlGenAnalyzerPackOutput Condition="'$(TlGenAnalyzerPackOutput)' == ''">..\Tl.Gen.CSharp\bin\$(Configuration)\netstandard2.0\</TlGenAnalyzerPackOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tl.Core\Tl.Core.csproj" />
    <ProjectReference Include="..\Tl.Gen.CSharp\Tl.Gen.CSharp.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="_._" Pack="true" PackagePath="lib\net10.0" />
    <None Include="..\Tl.Gen.CSharp\build\Tl.Gen.CSharp.targets" Pack="true" PackagePath="build\Tl.CSharp.targets;buildTransitive\Tl.CSharp.targets" />
    <None Include="$(TlGenAnalyzerPackOutput)Tl.Gen.CSharp.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
    <None Include="$(TlGenPackOutput)Tl.Gen.CSharp.dll" Pack="true" PackagePath="tools\net10.0\any" Visible="false" />
    <None Include="$(TlGenPackOutput)Tl.Gen.CSharp.pdb" Pack="true" PackagePath="tools\net10.0\any" Visible="false" />
    <None Include="$(TlGenPackOutput)Tl.Gen.CSharp.deps.json" Pack="true" PackagePath="tools\net10.0\any" Visible="false" />
    <None Include="$(TlGenPackOutput)Tl.Gen.CSharp.runtimeconfig.json" Pack="true" PackagePath="tools\net10.0\any" Visible="false" />
    <None Include="$(TlGenPackOutput)Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="tools\net10.0\any" Visible="false" />
    <None Include="$(TlGenPackOutput)Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="tools\net10.0\any" Visible="false" />
  </ItemGroup>

  <Target Name="BuildTlCSharpAnalyzer" BeforeTargets="GenerateNuspec" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="..\Tl.Gen.CSharp\Tl.Gen.CSharp.csproj"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
  </Target>

</Project>
