<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tl</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Frent</PackageId>
    <Authors>IAFahim</Authors>
    <Description>Frent host adapter: archetype chunk spans become timeline lane columns, one fused Apply per chunk.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Frent" Version="0.8.0-beta" />
    <ProjectReference Include="..\Tl.Core\Tl.Core.csproj" />
  </ItemGroup>

</Project>
