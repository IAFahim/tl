<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.5.0</Version>
    <PackageId>Tl.Runtime</PackageId>
    <Authors>IAFahim</Authors>
    <Description>Timelines compiled into C#, with typed struct hooks and caller-owned playback state.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v0.5.0: explicit unmanaged runtime ownership, 24-byte work slots, indexed views, unchanged input/result callback API, and verified NativeAOT playback. See docs/v0.5.md for migration and measured tradeoffs.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tl.Core.Tests" />
  </ItemGroup>

</Project>
