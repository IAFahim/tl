<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tl</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Runtime</PackageId>
    <Authors>IAFahim</Authors>
    <Description>Heterogeneous timelines compiled into direct C# kernels with borrowed typed contexts.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v1.0.0-alpha.10: tlb bakes JSON batches in parallel across all cores, byte-identical to serial (3.6x on 257 files); BakerAssemblyResolver.FromAssemblies scopes in-memory bake resolution; SIMD masks and a shared workspace cut a 20 MB bake from 71 to 60 ms. Playback surface unchanged; source, samples, and tooling byte budgets are enforced.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
