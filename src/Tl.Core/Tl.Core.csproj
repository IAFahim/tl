<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tl</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Runtime</PackageId>
    <Authors>IAFahim</Authors>
    <Description>Heterogeneous timelines compiled into direct C# kernels with borrowed typed contexts.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>v1.0.0-alpha.7: the typed playback lane (Timeline&lt;T&gt;.Seek(...).Apply(...) over BakedLane measured tables) is the only playback surface; the frame view slims to ushort positions under a single 65,535-tick cap with ClipLength and WithinClip on Frame; MeasuredLanes shares tables across set binds with the TickPurity.WindowConstant opt-in fill. The Timeline.Rows facade, kernel catalog, cycle, and game tick are removed.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
