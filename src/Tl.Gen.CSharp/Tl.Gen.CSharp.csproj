<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier">

  <PropertyGroup>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'netstandard2.0'">Library</OutputType>
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Gen.CSharp</PackageId>
    <Authors>IAFahim</Authors>
    <Description>Build-time generator that binds typed C# timeline consumers for data-authored timelines.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>timeline;ecs;burst;unity;dotnet;deterministic;baked-assets</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v3.0.0: SlotView v2 — segmented lane tables collapse duration-linear memory for long sparse timelines: 4 B per 64-tick directory bucket plus 16 B runs, flat escape below 2049 ticks, 72-byte header, movement derived arithmetically and never stored; retained memory on a 65,535-tick bank drops 28x with bit-identical playback checksums. No compatibility aliases: Tl.LaneMovementRecord is removed — the tail marker is SlotView.Skipped (0xFFFF); Inspection.BankSnapshot.ArenaBytes is removed — RetainedBytes is HeaderBytes + TableBytes + DirectoryBytes; the SlotView layout is ABI v3. New: public read-only Tl.Inspection snapshots (bank, tables, intern table); the consumer table grows past the 64-row wall; tlb gains --inspect, --live, and --exec verbs; a standalone timeline viewer ships on the pinned JSON contracts. v2.0.0: consumer vocabulary rename with no compatibility aliases: OnMemo is Fold, OnActive is ExecuteActive, ApplyLanes is ApplyChunk, and the (effects, inputs) Apply overload folded into the ColumnSet form — Apply(ids, clocks, forward, fx) for one effect column, Apply(ids, clocks, forward, in ColumnSet) for any columns, ApplyChunk(ids, clocks, forward, fx0, fx1) for two typed fold lanes. Fold semantics, caps, and playback receipts are unchanged. v1.0.0: first complete stable release. API settlement with no compatibility aliases: the consumer method Execute is now OnActive, Step is now Advance, and the typed Apply/Advance overloads live on the Timeline pair surface (the Lane facade is removed). Playback floors receipted on every host shape and CPU tier: shared-clock crowds 0.08 ns/row, per-entity calls 0.80 ns forward, non-AVX2 tiers 0.48 ns via the kernel tier ladder and flat record arena, bit-exact across AVX2, Vector128, and scalar. Bakes dispatch by discovered signature through the IBake marker; the live playground handles arbitrary valid authoring. Pair-typed folding is pair-isolated: Timeline&lt;TTrack,TClip&gt; measures and plays only its own pair, never another pair's consumers. OnActive with no gameplay parameters registers a dispatch-only consumer, fired per row at the position's tick by the no-output Apply(indices, positions, forward) overload.</PackageReleaseNotes>
    <EnforceExtendedAnalyzerRules Condition="'$(TargetFramework)' == 'netstandard2.0'">true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="CompileGenerationCache.cs;GeneratorCli.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="build\Tl.Gen.CSharp.targets" Pack="true" PackagePath="build\Tl.Gen.CSharp.targets;buildTransitive\Tl.Gen.CSharp.targets" />
    <None Include="$(TlGenAnalyzerPackOutput)Tl.Gen.CSharp.dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <TlGenAnalyzerPackOutput Condition="'$(TlGenAnalyzerPackOutput)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\</TlGenAnalyzerPackOutput>
    <TlGenPackOutput Condition="'$(TlGenPackOutput)' == ''">$(MSBuildProjectDirectory)\bin\$(Configuration)\net10.0\</TlGenPackOutput>
  </PropertyGroup>

</Project>
