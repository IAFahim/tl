<Project>
  <PropertyGroup>
    <_TlGenProject>$(MSBuildThisFileDirectory)..\Tl.Gen.CSharp.csproj</_TlGenProject>
    <_TlGenPkgTool>$(MSBuildThisFileDirectory)../tools/net10.0/any/Tl.Gen.CSharp.dll</_TlGenPkgTool>
    <_TlGenProjBin>$(MSBuildThisFileDirectory)../bin/$(Configuration)/net10.0/Tl.Gen.CSharp.dll</_TlGenProjBin>
    <_TlGenProjCompiler>$(MSBuildThisFileDirectory)../bin/$(Configuration)/netstandard2.0/Tl.Compiler.dll</_TlGenProjCompiler>
    <_TlGenDotNet Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_TlGenDotNet>
    <_TlGenDotNet Condition="'$(_TlGenDotNet)' == ''">dotnet</_TlGenDotNet>
    <TlGenAssembly Condition="'$(TlGenAssembly)' == '' and Exists('$(_TlGenPkgTool)')">$(_TlGenPkgTool)</TlGenAssembly>
    <TlGenAssembly Condition="'$(TlGenAssembly)' == '' and Exists('$(_TlGenProjBin)')">$(_TlGenProjBin)</TlGenAssembly>
    <TlGenAssembly Condition="'$(TlGenAssembly)' == ''">$(MSBuildThisFileDirectory)../bin/Release/net10.0/Tl.Gen.CSharp.dll</TlGenAssembly>
    <TlGenBackend Condition="'$(TlGenBackend)' == ''">csharp</TlGenBackend>
    <TlGenOutput Condition="'$(TlGenOutput)' == ''">$(IntermediateOutputPath)TlGenCompile\</TlGenOutput>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(_TlGenProject)')">
    <Analyzer Include="$(_TlGenProjCompiler)" />
  </ItemGroup>

  <Target Name="_TlGenBuildExportTool"
          BeforeTargets="TlGenExport"
          Condition="Exists('$(_TlGenProject)') And !Exists('$(_TlGenProjBin)')">
    <MSBuild Projects="$(_TlGenProject)"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
  </Target>

  <Target Name="TlGenExport"
          DependsOnTargets="ResolveProjectReferences;ResolveAssemblyReferences;ResolveReferences;GenerateGlobalUsings"
          Condition="'@(Compile)' != '' Or Exists('$(TlGenOutput)\TlGenCompile.manifest.json')">
    <PropertyGroup>
      <_TlGenCompileOut>$([MSBuild]::EnsureTrailingSlash('$(TlGenOutput)'))</_TlGenCompileOut>
      <_TlGenCompileSourceList>$(_TlGenCompileOut)TlGenCompile.sources</_TlGenCompileSourceList>
      <_TlGenCompileInputList>$(_TlGenCompileOut)TlGenCompile.inputs</_TlGenCompileInputList>
      <_TlGenCompileReferenceList>$(_TlGenCompileOut)TlGenCompile.references</_TlGenCompileReferenceList>
      <_TlGenCompileOptionList>$(_TlGenCompileOut)TlGenCompile.options</_TlGenCompileOptionList>
    </PropertyGroup>
    <ItemGroup>
      <_TlGenCompileInputs Include="@(Compile)"
                           Exclude="$(_TlGenCompileOut)**\*" />
      <_TlGenCompileReferences Include="@(ReferencePathWithRefAssemblies)" />
      <_TlGenCompileReferences Include="@(ReferencePath)"
                               Condition="'@(_TlGenCompileReferences)' == ''" />
      <_TlGenCompileOptions Include="language-version=$(LangVersion)" />
      <_TlGenCompileOptions Include="nullable=$(Nullable)" />
      <_TlGenCompileOptions Include="allow-unsafe=$(AllowUnsafeBlocks)" />
      <_TlGenCompileOptions Include="check-overflow=$(CheckForOverflowUnderflow)" />
    </ItemGroup>
    <MakeDir Directories="$(_TlGenCompileOut)" />
    <WriteLinesToFile File="$(_TlGenCompileInputList)"
                      Lines="@(_TlGenCompileInputs->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_TlGenCompileReferenceList)"
                      Lines="@(_TlGenCompileReferences->'%(FullPath)&#x9;%(Aliases)&#x9;%(EmbedInteropTypes)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(_TlGenCompileOptionList)"
                      Lines="@(_TlGenCompileOptions)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Exec Command="&quot;$(_TlGenDotNet)&quot; &quot;$(TlGenAssembly)&quot; --compile --backend &quot;$(TlGenBackend)&quot; --output &quot;$(_TlGenCompileOut)&quot; --define &quot;$(DefineConstants)&quot; --source-list &quot;$(_TlGenCompileInputList)&quot; --reference-list &quot;$(_TlGenCompileReferenceList)&quot; --option-list &quot;$(_TlGenCompileOptionList)&quot;" />
    <ItemGroup>
      <FileWrites Include="$(_TlGenCompileOut)**\*.g.cs" />
      <FileWrites Include="$(_TlGenCompileSourceList)" />
      <FileWrites Include="$(_TlGenCompileInputList)" />
      <FileWrites Include="$(_TlGenCompileReferenceList)" />
      <FileWrites Include="$(_TlGenCompileOptionList)" />
      <FileWrites Include="$(_TlGenCompileOut)TlGenCompile.manifest.json" />
      <FileWrites Include="$(_TlGenCompileOut)TlGenCompile.report.txt" />
    </ItemGroup>
  </Target>
</Project>
