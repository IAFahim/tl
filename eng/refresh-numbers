#!/usr/bin/env python3
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import render_numbers

root = Path(__file__).resolve().parent.parent
receipt_path = root / render_numbers.RECEIPT_PATH
extra = sys.argv[1:]

subprocess.run(
    ["dotnet", "build", "benchmarks/Numbers/Numbers.csproj", "-c", "Release"],
    cwd=root, check=True,
)
cmd = [
    "dotnet", "run", "--project", "benchmarks/Numbers", "-c", "Release", "--no-build", "--",
    "--corpus", str(root / "benchmarks/Numbers/results/corpus"),
    "--out", str(receipt_path),
    *extra,
]
print("$", " ".join(cmd), flush=True)
subprocess.run(cmd, cwd=root, check=True)

receipt = render_numbers.load_receipt(root)
readme_path = root / "README.md"
readme_path.write_text(render_numbers.apply(receipt, readme_path.read_text(encoding="utf-8")), encoding="utf-8")
print(f"README.md Numbers section rendered from {render_numbers.RECEIPT_PATH}")
