#!/usr/bin/env bash
set -euo pipefail

project_number="${TL_PROJECT_NUMBER:-6}"
agent_name="${TL_AGENT:-${USER:-agent}}"
machine_name="${TL_MACHINE:-$(hostname)}"
repository_owner=""
project_node_id=""
declare -A project_field_ids=()
declare -A project_status_ids=()
remote_claim_commit=""
remote_claim_issue=""
remote_claim_agent=""
remote_claim_machine=""
remote_claim_branch=""
remote_claim_previous_agent=""
remote_claim_previous_machine=""
remote_claim_previous_claim=""
remote_claim_takeover_reason=""
remote_claim_ref=""
remote_claim_checkpoint=""
issue_transaction_commit=""
issue_transaction_issue=""
issue_transaction_held="false"

fail() {
    printf '%s\n' "$1" >&2
    exit 2
}

require_count() {
    [[ "$2" -ge "$1" ]] || fail "missing arguments"
}

validate_issue() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || fail "issue must be a positive integer"
}

validate_identity() {
    [[ "$agent_name" != *$'\n'* && "$agent_name" != *'='* && -n "$agent_name" ]] || fail "TL_AGENT must be one nonempty line without equals signs"
    [[ "$machine_name" != *$'\n'* && "$machine_name" != *'='* && -n "$machine_name" ]] || fail "TL_MACHINE must be one nonempty line without equals signs"
}

initialize_github() {
    repository_owner="$(gh repo view --json owner --jq .owner.login)"
    [[ -n "$repository_owner" ]] || fail "could not resolve the repository owner"
}

issue_url() {
    gh issue view "$1" --json url --jq .url
}

project_item() {
    gh project item-add "$project_number" --owner "$repository_owner" --url "$(issue_url "$1")" --format json --jq .id
}

project_claim() {
    gh project item-list "$project_number" --owner "$repository_owner" --format json --limit 1000 \
        --jq ".items[] | select(.content.number == $1 and .content.type == \"Issue\") | [.id, (.status // \"\"), (.agent // \"\"), (.machine // \"\"), (.branch // \"\"), (.checkpoint // \"\"), \"TL_CLAIM_END\"] | .[]"
}

load_project_claim() {
    local issue="$1"
    local target="$2"
    local output
    local -n values="$target"
    output="$(project_claim "$issue")" || fail "could not read issue #$issue from Project $project_number"
    values=()
    if [[ -n "$output" ]]; then
        mapfile -t values <<<"$output"
        [[ "${#values[@]}" -eq 7 && "${values[6]}" == "TL_CLAIM_END" ]] || fail "issue #$issue has an unreadable Project claim"
        unset 'values[6]'
    fi
}

load_project_schema() {
    local output
    local kind
    local name
    local id
    [[ -n "$project_node_id" ]] && return
    project_node_id="$(gh project view "$project_number" --owner "$repository_owner" --format json --jq .id)"
    output="$(gh project field-list "$project_number" --owner "$repository_owner" --format json --jq '.fields[] | if .name == "Status" then "FIELD\tStatus\t\(.id)", (.options[] | "STATUS\t\(.name)\t\(.id)") elif (.name == "Agent" or .name == "Machine" or .name == "Branch" or .name == "Checkpoint") then "FIELD\t\(.name)\t\(.id)" else empty end')"
    while IFS=$'\t' read -r kind name id; do
        if [[ "$kind" == "FIELD" ]]; then
            project_field_ids["$name"]="$id"
        elif [[ "$kind" == "STATUS" ]]; then
            project_status_ids["$name"]="$id"
        fi
    done <<<"$output"
    [[ -n "$project_node_id" ]] || fail "Project $project_number has no node ID"
    for name in Status Agent Machine Branch Checkpoint; do
        [[ -n "${project_field_ids[$name]:-}" ]] || fail "Project $project_number is missing the $name field"
    done
}

set_text() {
    load_project_schema
    gh project item-edit --id "$1" --project-id "$project_node_id" --field-id "${project_field_ids[$2]}" --text "$3" >/dev/null
}

set_status() {
    load_project_schema
    [[ -n "${project_status_ids[$2]:-}" ]] || fail "Project $project_number Status has no '$2' option"
    gh project item-edit --id "$1" --project-id "$project_node_id" --field-id "${project_field_ids[Status]}" --single-select-option-id "${project_status_ids[$2]}" >/dev/null
}

post() {
    local body
    body="$(mktemp)"
    printf '%s\n' "$2" >"$body"
    if gh issue comment "$1" --body-file "$body"; then
        rm -f "$body"
    else
        local status="$?"
        rm -f "$body"
        return "$status"
    fi
}

post_once() {
    local issue="$1"
    local marker="$2"
    local body="$3"
    local comments
    comments="$(gh issue view "$issue" --json comments --jq '.comments[].body')" || return 1
    grep -Fq -- "$marker" <<<"$comments" || post "$issue" "$body"
}

create_issue() {
    require_count 4 "$#"
    local title="$1"
    local area="$2"
    local kind="$3"
    local body_file="$4"
    local milestone="${5:-}"
    local url
    local issue
    local item
    [[ "$area" =~ ^area:[a-z0-9-]+$ ]] || fail "area label must use area:<name>"
    [[ "$kind" =~ ^kind:[a-z0-9-]+$ ]] || fail "kind label must use kind:<name>"
    [[ -f "$body_file" ]] || fail "issue body file does not exist"
    if [[ -n "$milestone" ]]; then
        url="$(gh issue create --title "$title" --body-file "$body_file" --label ai --label "$area" --label "$kind" --milestone "$milestone")"
    else
        url="$(gh issue create --title "$title" --body-file "$body_file" --label ai --label "$area" --label "$kind")"
    fi
    issue="${url##*/}"
    begin_issue_transaction "$issue" "create issue"
    validate_issue "$issue"
    item="$(project_item "$issue")"
    set_status "$item" Ready
    end_issue_transaction
    printf '%s\n' "$url"
}

assert_clean() {
    [[ -z "$(git status --porcelain)" ]] || fail "commit the owned changes before publishing a checkpoint"
}

assert_issue_open() {
    [[ "$(gh issue view "$1" --json state --jq .state)" == "OPEN" ]] || fail "issue #$1 is not open"
}

read_issue_state() {
    local issue="$1"
    local target="$2"
    local state
    state="$(gh issue view "$issue" --json state --jq .state)" || fail "could not read issue #$issue state"
    [[ "$state" == "OPEN" || "$state" == "CLOSED" ]] || fail "issue #$issue returned unknown state '$state'"
    printf -v "$target" '%s' "$state"
}

assert_issue_taxonomy() {
    local labels
    labels="$(gh issue view "$1" --json labels --jq '[.labels[].name] | join("\n")')"
    grep -Fxq ai <<<"$labels" || fail "issue #$1 must have the ai label"
    grep -Eq '^area:' <<<"$labels" || fail "issue #$1 must have an area:* label"
    grep -Eq '^kind:' <<<"$labels" || fail "issue #$1 must have a kind:* label"
}

assert_assigned() {
    local login
    login="$(gh api user --jq .login)"
    gh issue view "$1" --json assignees --jq '.assignees[].login' | grep -Fxq "$login" || fail "issue #$1 is not assigned to $login"
}

validate_workstream() {
    [[ "$1" =~ ^(feat|fix|perf|refactor|docs|test|build|ci|chore|release)$ ]] || fail "kind must be feat, fix, perf, refactor, docs, test, build, ci, chore, or release"
    [[ "$2" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "slug must contain lowercase words separated by hyphens"
}

workstream_branch() {
    printf '%s/%s-%s\n' "$2" "$1" "$3"
}

claim_ref() {
    local issue="$1"
    local branch="$2"
    local kind="${branch%%/*}"
    local name="${branch#*/}"
    if [[ "$name" == "$issue-"* ]] && [[ "$kind" =~ ^(feat|fix|perf|refactor|docs|test|build|ci|chore|release)$ ]]; then
        printf 'refs/heads/workstream-claims/%s/%s/%s\n' "$issue" "$kind" "${name#"$issue-"}"
    else
        printf 'refs/heads/claims/%s\n' "$issue"
    fi
}

legacy_claim_ref() {
    local issue="$1"
    local branch="$2"
    local kind="${branch%%/*}"
    local name="${branch#*/}"
    if [[ "$name" == "$issue-"* ]] && [[ "$kind" =~ ^(feat|fix|perf|refactor|docs|test|build|ci|chore|release)$ ]]; then
        printf 'refs/heads/claims/%s/%s/%s\n' "$issue" "$kind" "${name#"$issue-"}"
    else
        printf 'refs/heads/claims/%s\n' "$issue"
    fi
}

load_claim_pointer() {
    local issue="$1"
    local branch="$2"
    local ref_target="$3"
    local commit_target="$4"
    local current
    local legacy
    local output
    local row_commit
    local row_ref
    local found_ref=""
    local found_commit=""
    current="$(claim_ref "$issue" "$branch")"
    legacy="$(legacy_claim_ref "$issue" "$branch")"
    output="$(git ls-remote --heads origin "$current" "$legacy" 2>/dev/null)" || fail "could not read workstream '$branch' claim"
    while read -r row_commit row_ref; do
        [[ -n "$row_commit" && -n "$row_ref" ]] || continue
        [[ -z "$found_ref" ]] || fail "workstream '$branch' has both current and legacy claims"
        found_ref="$row_ref"
        found_commit="$row_commit"
    done <<<"$output"
    printf -v "$ref_target" '%s' "$found_ref"
    printf -v "$commit_target" '%s' "$found_commit"
}

load_claim_commit() {
    local issue="$1"
    local branch="$2"
    local target="$3"
    local ref
    local commit
    load_claim_pointer "$issue" "$branch" ref commit
    printf -v "$target" '%s' "$commit"
}

load_remote_branch() {
    local branch="$1"
    local target="$2"
    local output
    local found_commit
    output="$(git ls-remote --heads origin "refs/heads/$branch" 2>/dev/null)" || fail "could not read remote branch '$branch'"
    found_commit="$(awk 'NR == 1 { print $1 }' <<<"$output")"
    printf -v "$target" '%s' "$found_commit"
}

claim_message() {
    local issue="$1"
    local branch="$2"
    local ref="$3"
    local expected="$4"
    local local_ref="refs/tl/claims/$issue/$(printf '%s' "$branch" | tr / -)"
    git fetch --quiet origin "+$ref:$local_ref" || fail "could not load workstream '$branch' claim object"
    [[ "$(git rev-parse "$local_ref")" == "$expected" ]] || fail "workstream '$branch' claim changed while loading its object"
    git show -s --format=%B "$local_ref"
}

claim_local_ref() {
    printf 'refs/tl/claims/%s/%s\n' "$1" "$(printf '%s' "$2" | tr / -)"
}

claim_value() {
    sed -n "s/^$2=//p" <<<"$1"
}

load_remote_claim() {
    local issue="$1"
    local branch="$2"
    local message
    load_claim_pointer "$issue" "$branch" remote_claim_ref remote_claim_commit
    [[ -n "$remote_claim_commit" ]] || return 1
    message="$(claim_message "$issue" "$branch" "$remote_claim_ref" "$remote_claim_commit")"
    remote_claim_issue="$(claim_value "$message" issue)"
    remote_claim_agent="$(claim_value "$message" agent)"
    remote_claim_machine="$(claim_value "$message" machine)"
    remote_claim_branch="$(claim_value "$message" branch)"
    remote_claim_previous_agent="$(claim_value "$message" previous_agent)"
    remote_claim_previous_machine="$(claim_value "$message" previous_machine)"
    remote_claim_previous_claim="$(claim_value "$message" previous_claim)"
    remote_claim_takeover_reason="$(claim_value "$message" takeover_reason)"
    remote_claim_checkpoint="$(git rev-parse "$(claim_local_ref "$issue" "$branch")^")"
    [[ "$remote_claim_issue" == "$issue" && -n "$remote_claim_agent" && -n "$remote_claim_machine" && "$remote_claim_branch" == "$branch" ]] || fail "issue #$issue has a malformed atomic claim"
}

assert_remote_claim() {
    local issue="$1"
    local branch="$2"
    load_remote_claim "$issue" "$branch" || fail "workstream '$branch' has no atomic remote claim"
    [[ "$remote_claim_agent" == "$agent_name" ]] || fail "issue #$issue is atomically claimed by agent '$remote_claim_agent'"
    [[ "$remote_claim_machine" == "$machine_name" ]] || fail "issue #$issue is atomically claimed on machine '$remote_claim_machine'"
    [[ "$remote_claim_branch" == "$branch" ]] || fail "issue #$issue atomically owns branch '$remote_claim_branch', not '$branch'"
}

new_claim_commit() {
    local issue="$1"
    local branch="$2"
    local base="$3"
    local message
    message="issue=$issue
agent=$agent_name
machine=$machine_name
branch=$branch
nonce=$(date -u +%Y%m%dT%H%M%S%N)-$$"
    printf '%s\n' "$message" | git commit-tree "$(git rev-parse "$base^{tree}")" -p "$base"
}

new_takeover_claim_commit() {
    local issue="$1"
    local branch="$2"
    local base="$3"
    local previous_agent="$4"
    local previous_machine="$5"
    local previous_claim="$6"
    local reason="$7"
    local message
    message="issue=$issue
agent=$agent_name
machine=$machine_name
branch=$branch
previous_agent=$previous_agent
previous_machine=$previous_machine
previous_claim=$previous_claim
takeover_reason=$reason
nonce=$(date -u +%Y%m%dT%H%M%S%N)-$$"
    printf '%s\n' "$message" | git commit-tree "$(git rev-parse "$base^{tree}")" -p "$base"
}

acquire_claim() {
    local issue="$1"
    local branch="$2"
    local base="$3"
    local commit
    local existing
    load_claim_commit "$issue" "$branch" existing
    [[ -z "$existing" ]] || fail "workstream '$branch' already has an atomic remote claim"
    commit="$(new_claim_commit "$issue" "$branch" "$base")"
    git push origin "$commit:$(claim_ref "$issue" "$branch")" >/dev/null || fail "workstream '$branch' was claimed concurrently"
    printf '%s\n' "$commit"
}

release_claim() {
    local issue="$1"
    local branch="$2"
    local expected="$3"
    local ref
    local commit
    load_claim_pointer "$issue" "$branch" ref commit
    [[ -n "$ref" && "$commit" == "$expected" ]] || return 1
    if git push --force-with-lease="$ref:$expected" origin ":$ref" >/dev/null; then
        return
    fi
    local remaining_ref
    local remaining_commit
    load_claim_pointer "$issue" "$branch" remaining_ref remaining_commit
    [[ -z "$remaining_ref" ]]
}

publish_branch() {
    local issue="$1"
    local branch="$2"
    local expected="$3"
    local replacement
    local ref
    local commit
    load_claim_pointer "$issue" "$branch" ref commit
    [[ -n "$ref" ]] || fail "workstream '$branch' has no atomic remote claim"
    replacement="$(new_claim_commit "$issue" "$branch" HEAD)"
    git push --atomic --set-upstream --force-with-lease="$ref:$expected" origin \
        "HEAD:refs/heads/$branch" "$replacement:$ref" >/dev/null || fail "workstream '$branch' claim changed while publishing"
    remote_claim_commit="$replacement"
}

has_other_active_claims() {
    local issue="$1"
    local excluded="$2"
    local refs
    refs="$(git ls-remote --heads origin "refs/heads/claims/$issue" "refs/heads/claims/$issue/*" "refs/heads/workstream-claims/$issue/*" 2>/dev/null)" || fail "could not enumerate active claims for issue #$issue"
    awk -v excluded="$excluded" '$2 != excluded { found = 1 } END { exit !found }' <<<"$refs"
}

issue_transaction_ref() {
    printf 'refs/heads/issue-transactions/%s\n' "$1"
}

load_issue_transaction() {
    local issue="$1"
    local target="$2"
    local output
    local commit
    output="$(git ls-remote --heads origin "$(issue_transaction_ref "$issue")" 2>/dev/null)" || fail "could not read issue #$issue transaction"
    commit="$(awk 'NR == 1 { print $1 }' <<<"$output")"
    printf -v "$target" '%s' "$commit"
}

new_issue_transaction_commit() {
    local issue="$1"
    local operation="$2"
    local message
    message="issue=$issue
agent=$agent_name
machine=$machine_name
operation=$operation
nonce=$(date -u +%Y%m%dT%H%M%S%N)-$$"
    printf '%s\n' "$message" | git commit-tree "$(git rev-parse 'HEAD^{tree}')" -p HEAD
}

new_recovery_transaction_commit() {
    local issue="$1"
    local recovered="$2"
    local previous="$3"
    local reason="$4"
    local message
    message="issue=$issue
agent=$agent_name
machine=$machine_name
operation=recover stale transaction
recovered_transaction=$recovered
previous_transaction=$previous
recovery_reason=$reason
nonce=$(date -u +%Y%m%dT%H%M%S%N)-$$"
    printf '%s\n' "$message" | git commit-tree "$(git rev-parse 'HEAD^{tree}')" -p HEAD
}

issue_transaction_message() {
    local issue="$1"
    local expected="$2"
    local ref
    local local_ref="refs/tl/transactions/$issue"
    ref="$(issue_transaction_ref "$issue")"
    git fetch --quiet origin "+$ref:$local_ref" || fail "could not read issue #$issue transaction"
    [[ "$(git rev-parse "$local_ref")" == "$expected" ]] || fail "issue #$issue transaction changed while reading recovery state"
    git show -s --format=%B "$local_ref"
}

cleanup_issue_transaction() {
    local status="$?"
    if [[ "$issue_transaction_held" == "true" ]]; then
        git push --force-with-lease="$(issue_transaction_ref "$issue_transaction_issue"):$issue_transaction_commit" origin ":$(issue_transaction_ref "$issue_transaction_issue")" >/dev/null 2>&1 || true
    fi
    exit "$status"
}

begin_issue_transaction() {
    local issue="$1"
    local operation="$2"
    local existing
    local commit
    load_issue_transaction "$issue" existing
    [[ -z "$existing" ]] || fail "issue #$issue has active transaction $existing; retry later or recover the confirmed-stale transaction"
    commit="$(new_issue_transaction_commit "$issue" "$operation")"
    git push origin "$commit:$(issue_transaction_ref "$issue")" >/dev/null || fail "issue #$issue transaction was acquired concurrently"
    issue_transaction_commit="$commit"
    issue_transaction_issue="$issue"
    issue_transaction_held="true"
    trap cleanup_issue_transaction EXIT
}

end_issue_transaction() {
    local ref
    ref="$(issue_transaction_ref "$issue_transaction_issue")"
    if ! git push --force-with-lease="$ref:$issue_transaction_commit" origin ":$ref" >/dev/null; then
        local existing
        load_issue_transaction "$issue_transaction_issue" existing
        [[ -z "$existing" ]] || {
            issue_transaction_held="false"
            trap - EXIT
            fail "issue #$issue_transaction_issue transaction changed before release"
        }
    fi
    issue_transaction_held="false"
    trap - EXIT
}

recover_issue_transaction() {
    require_count 3 "$#"
    local issue="$1"
    local expected="$2"
    local reason="$3"
    local current
    local replacement
    local ref
    local message
    local recovered
    validate_issue "$issue"
    validate_identity
    [[ "$expected" =~ ^[0-9a-f]{40,64}$ ]] || fail "expected transaction must be a full Git object ID"
    [[ -n "$reason" && "$reason" != *$'\n'* ]] || fail "recovery reason must be one nonempty line"
    load_issue_transaction "$issue" current
    if [[ -z "$current" ]]; then
        if gh issue view "$issue" --json comments --jq '.comments[].body' | grep -Eq -- "- (Recovered transaction|Recovery predecessor|Recovery lock): \`$expected\`"; then
            printf 'issue #%s transaction %s is already recovered\n' "$issue" "$expected"
            return
        fi
        fail "issue #$issue transaction changed; expected $expected, found none"
    fi
    [[ "$current" == "$expected" ]] || fail "issue #$issue transaction changed; expected $expected, found ${current:-none}"
    ref="$(issue_transaction_ref "$issue")"
    message="$(issue_transaction_message "$issue" "$expected")"
    recovered="$(claim_value "$message" recovered_transaction)"
    [[ -n "$recovered" ]] || recovered="$expected"
    replacement="$(new_recovery_transaction_commit "$issue" "$recovered" "$expected" "$reason")"
    git push --force-with-lease="$ref:$expected" origin "$replacement:$ref" >/dev/null || fail "issue #$issue transaction changed during recovery"
    issue_transaction_commit="$replacement"
    issue_transaction_issue="$issue"
    issue_transaction_held="false"
    trap - EXIT
    if ! post_once "$issue" "- Recovered transaction: \`$recovered\`" "### Transaction recovery

- Agent: $agent_name
- Machine: $machine_name
- Recovered transaction: \`$recovered\`
- Recovery predecessor: \`$expected\`
- Recovery lock: \`$replacement\`
- Reason: $reason"; then
        fail "issue #$issue recovery audit failed; recovery lock $replacement remains; retry with that exact lock"
    fi
    issue_transaction_held="true"
    trap cleanup_issue_transaction EXIT
    end_issue_transaction
}

assert_claimed_checkpoint() {
    local branch="$1"
    local head="$2"
    [[ "$remote_claim_checkpoint" == "$head" ]] || fail "local HEAD $head is not the claimed checkpoint $remote_claim_checkpoint"
    git fetch --quiet origin "$branch" || fail "workstream '$branch' has no published remote branch"
    [[ "$(git rev-parse "origin/$branch")" == "$head" ]] || fail "local HEAD $head is not the remote branch checkpoint"
}

publish_checkpoint_projection() {
    local issue="$1"
    local branch="$2"
    local commit="$3"
    local claim="$4"
    local owner_agent="$5"
    local owner_machine="$6"
    local result="$7"
    local validation="$8"
    local risks="$9"
    local item
    item="$(project_item "$issue")"
    set_text "$item" Agent "$owner_agent"
    set_text "$item" Machine "$owner_machine"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$commit"
    set_status "$item" "In progress"
    post_once "$issue" "- Checkpoint claim: \`$claim\`" "### Green checkpoint

- Agent: $owner_agent
- Machine: $owner_machine
- Branch: \`$branch\`
- Commit: \`$commit\`
- Checkpoint claim: \`$claim\`
- Result: $result
- Validation: $validation
- Remaining risks: $risks"
}

assert_claim() {
    local issue="$1"
    local mode="${2:-active}"
    local branch
    local -a claim=()
    branch="$(git branch --show-current)"
    load_project_claim "$issue" claim
    [[ "${#claim[@]}" -eq 6 ]] || fail "issue #$issue is not attached to Project $project_number"
    case "$mode" in
        active)
            [[ "${claim[1]}" == "In progress" || "${claim[1]}" == "In review" ]] || fail "issue #$issue is not actively claimed"
            assert_remote_claim "$issue" "$branch"
            assert_issue_open "$issue"
            ;;
        handoff)
            [[ "${claim[1]}" == "In progress" || "${claim[1]}" == "In review" || "${claim[1]}" == "Ready" ]] || fail "issue #$issue cannot resume a handoff from status '${claim[1]}'"
            assert_remote_claim "$issue" "$branch"
            assert_issue_open "$issue"
            ;;
        completion)
            [[ "${claim[1]}" == "In progress" || "${claim[1]}" == "In review" || "${claim[1]}" == "Ready" || "${claim[1]}" == "Done" ]] || fail "issue #$issue cannot resume completion from status '${claim[1]}'"
            load_remote_claim "$issue" "$branch" || fail "workstream '$branch' has no atomic remote claim"
            [[ "$remote_claim_branch" == "$branch" ]] || fail "issue #$issue atomically owns branch '$remote_claim_branch', not '$branch'"
            ;;
        *) fail "unknown claim assertion mode '$mode'" ;;
    esac
    assert_issue_taxonomy "$issue"
    assert_assigned "$issue"
}

ensure_worktree() {
    local worktree="$1"
    local branch="$2"
    local base="$3"
    local expected
    expected="$(git rev-parse "$base")"
    if [[ -e "$worktree" ]]; then
        [[ "$(git -C "$worktree" branch --show-current)" == "$branch" ]] || fail "worktree path is owned by another branch: $worktree"
        [[ -z "$(git -C "$worktree" status --porcelain)" ]] || fail "worktree '$worktree' has unpublished changes; checkpoint or restore it before resuming"
        [[ "$(git -C "$worktree" rev-parse HEAD)" == "$expected" ]] || fail "worktree '$worktree' is not at the claimed checkpoint $expected"
        return
    fi
    git worktree prune
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        [[ "$(git rev-parse "$branch")" == "$expected" ]] || fail "local branch '$branch' is stale; move it to the remote checkpoint $expected before starting"
        git worktree add "$worktree" "$branch"
    else
        git worktree add "$worktree" -b "$branch" "$expected"
    fi
}

worktree_path() {
    printf '%s/%s-%s-%s-%s\n' "$(dirname "$1")" "$(basename "$1")" "$2" "$3" "$4"
}

resolve_start_base() {
    local requested="$1"
    local target="$2"
    local remote_branch
    local commit
    if [[ "$requested" == origin/* ]]; then
        remote_branch="${requested#origin/}"
        git check-ref-format --branch "$remote_branch" >/dev/null 2>&1 || fail "invalid remote start base '$requested'"
        git fetch origin "$remote_branch" >/dev/null 2>&1 || fail "remote start base '$requested' does not exist"
    fi
    commit="$(git rev-parse --verify "$requested^{commit}" 2>/dev/null)" || fail "start base '$requested' is not a commit"
    printf -v "$target" '%s' "$commit"
}

publish_claim() {
    local issue="$1"
    local branch="$2"
    local worktree="$3"
    local scope="$4"
    local state="$5"
    local requested_base="${6:-recorded checkpoint}"
    local item
    gh issue edit "$issue" --add-assignee "@me" >/dev/null
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$(git -C "$worktree" rev-parse HEAD)"
    set_status "$item" "$state"
    post_once "$issue" "- Claim: \`$remote_claim_commit\`" "### Work claim

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$branch\`
- Worktree: \`$worktree\`
- Requested base: \`$requested_base\`
- Exact checkpoint: \`$(git -C "$worktree" rev-parse HEAD)\`
- Claim: \`$remote_claim_commit\`
- Scope: $scope
- State: $state"
}

load_closed_cleanup_checkpoint() {
    local issue="$1"
    local branch="$2"
    local claim="$3"
    local target="$4"
    local comments
    local line
    local recent_checkpoint=""
    local marker="- Released closed-issue workstream: \`$branch@$claim\`"
    comments="$(gh issue view "$issue" --json comments --jq '.comments[].body')" || fail "could not read issue #$issue cleanup audit"
    while IFS= read -r line; do
        if [[ "$line" =~ ^-\ Checkpoint:\ \`([0-9a-f]{40,64})\`$ ]]; then
            recent_checkpoint="${BASH_REMATCH[1]}"
        elif [[ "$line" == "$marker" ]]; then
            [[ -n "$recent_checkpoint" ]] || fail "issue #$issue has a malformed cleanup audit for workstream '$branch'"
            printf -v "$target" '%s' "$recent_checkpoint"
            return
        fi
    done <<<"$comments"
    return 1
}

publish_terminal_projection() {
    local issue="$1"
    local branch="$2"
    local checkpoint="$3"
    local terminal_status="$4"
    local item
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$checkpoint"
    if has_other_active_claims "$issue" ""; then
        set_status "$item" "In progress"
    else
        set_status "$item" "$terminal_status"
    fi
}

release_closed_start_claim() {
    local issue="$1"
    local branch="$2"
    local checkpoint="$3"
    local expected="$4"
    local reason="${5:-issue closed before the workstream became resumable}"
    local item
    local status
    local previous_status
    local -a project=()
    load_project_claim "$issue" project
    previous_status="${project[1]:-In progress}"
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$checkpoint"
    if has_other_active_claims "$issue" "$remote_claim_ref"; then
        status="In progress"
    else
        status="Done"
    fi
    set_status "$item" "$status"
    post_once "$issue" "- Released closed-issue workstream: \`$branch@$expected\`" "### Closed issue claim cleanup

- Previous agent: ${remote_claim_agent:-$agent_name}
- Previous machine: ${remote_claim_machine:-$machine_name}
- Released by: $agent_name on $machine_name
- Branch: \`$branch\`
- Checkpoint: \`$checkpoint\`
- Released closed-issue claim: \`$expected\`
- Released closed-issue workstream: \`$branch@$expected\`
- Reason: $reason
- State: $status"
    if ! release_claim "$issue" "$branch" "$expected"; then
        set_status "$item" "$previous_status"
        fail "closed issue #$issue claim changed before cleanup"
    fi
}

start_work() {
    require_count 4 "$#"
    local issue="$1"
    local kind="$2"
    local slug="$3"
    local scope="$4"
    local repository_root
    local worktree
    local branch
    local base
    local requested_base="${5:-origin/main}"
    local claim_commit
    local existing_claim
    local remote_branch_commit
    local issue_state
    local -a claim=()
    validate_issue "$issue"
    validate_identity
    validate_workstream "$kind" "$slug"
    assert_issue_taxonomy "$issue"
    repository_root="$(git rev-parse --show-toplevel)"
    worktree="$(worktree_path "$repository_root" "$issue" "$kind" "$slug")"
    branch="$(workstream_branch "$issue" "$kind" "$slug")"
    load_project_claim "$issue" claim
    load_claim_commit "$issue" "$branch" existing_claim
    if [[ -n "$existing_claim" ]]; then
        assert_remote_claim "$issue" "$branch"
        base="$(git rev-parse "refs/tl/claims/$issue/$(printf '%s' "$branch" | tr / -)^")"
        begin_issue_transaction "$issue" "resume $branch"
        assert_remote_claim "$issue" "$branch"
        read_issue_state "$issue" issue_state
        if [[ "$issue_state" != "OPEN" ]]; then
            release_closed_start_claim "$issue" "$branch" "$base" "$remote_claim_commit"
            end_issue_transaction
            fail "issue #$issue is closed; released workstream '$branch' claim"
        fi
        ensure_worktree "$worktree" "$branch" "$base"
        publish_claim "$issue" "$branch" "$worktree" "$scope" "In progress" "recorded claim checkpoint"
        end_issue_transaction
        printf '%s\n' "$worktree"
        return
    fi
    [[ ! -e "$worktree" ]] || fail "worktree already exists without a remote claim: $worktree"
    resolve_start_base "$requested_base" base
    load_remote_branch "$branch" remote_branch_commit
    if [[ -n "$remote_branch_commit" ]]; then
        git fetch origin "$branch"
        resolve_start_base "origin/$branch" base
        requested_base="origin/$branch"
    fi
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        [[ "$(git rev-parse "$branch")" == "$base" ]] || fail "local branch '$branch' is stale; move it to the remote checkpoint $base before starting"
    fi
    begin_issue_transaction "$issue" "start $branch"
    assert_issue_open "$issue"
    claim_commit="$(acquire_claim "$issue" "$branch" "$base")"
    remote_claim_commit="$claim_commit"
    remote_claim_ref="$(claim_ref "$issue" "$branch")"
    remote_claim_agent="$agent_name"
    remote_claim_machine="$machine_name"
    remote_claim_branch="$branch"
    ensure_worktree "$worktree" "$branch" "$base"
    read_issue_state "$issue" issue_state
    if [[ "$issue_state" != "OPEN" ]]; then
        release_closed_start_claim "$issue" "$branch" "$base" "$remote_claim_commit"
        end_issue_transaction
        fail "issue #$issue closed during start; released workstream '$branch' claim"
    fi
    assert_remote_claim "$issue" "$branch"
    publish_claim "$issue" "$branch" "$worktree" "$scope" "In progress" "$requested_base"
    end_issue_transaction
    printf '%s\n' "$worktree"
}

adopt_work() {
    require_count 1 "$#"
    local issue="$1"
    local branch
    local claim_commit
    local existing_claim
    local -a claim=()
    validate_issue "$issue"
    validate_identity
    assert_clean
    assert_issue_open "$issue"
    assert_issue_taxonomy "$issue"
    assert_assigned "$issue"
    begin_issue_transaction "$issue" "adopt workstream"
    branch="$(git branch --show-current)"
    load_project_claim "$issue" claim
    [[ "${#claim[@]}" -eq 6 ]] || fail "issue #$issue is not attached to Project $project_number"
    [[ "${claim[1]}" == "In progress" || "${claim[1]}" == "In review" ]] || fail "issue #$issue has no active pre-lock claim"
    [[ "${claim[2]}" == "$agent_name" ]] || fail "issue #$issue is claimed by agent '${claim[2]}'"
    [[ "${claim[3]}" == "$machine_name" ]] || fail "issue #$issue is claimed on machine '${claim[3]}'"
    [[ "${claim[4]}" == "$branch" ]] || fail "issue #$issue owns branch '${claim[4]}', not '$branch'"
    git fetch origin "$branch"
    [[ "$(git rev-parse "origin/$branch")" == "$(git rev-parse HEAD)" ]] || fail "push the exact clean checkpoint before adopting a legacy claim"
    if [[ -n "${claim[5]}" ]]; then
        [[ "${claim[5]}" == "$(git rev-parse HEAD)" ]] || fail "the pushed branch does not match the recorded Project checkpoint"
    fi
    load_claim_commit "$issue" "$branch" existing_claim
    if [[ -n "$existing_claim" ]]; then
        assert_remote_claim "$issue" "$branch"
        post_once "$issue" "- Atomic migration claim: \`$remote_claim_commit\`" "### Atomic claim migration

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$branch\`
- Checkpoint: \`$(git rev-parse HEAD)\`
- Atomic migration claim: \`$remote_claim_commit\`
- State: ${claim[1]}"
        end_issue_transaction
        printf 'issue #%s already has atomic claim %s\n' "$issue" "$remote_claim_commit"
        return
    fi
    claim_commit="$(acquire_claim "$issue" "$branch" HEAD)"
    post_once "$issue" "- Atomic migration claim: \`$claim_commit\`" "### Atomic claim migration

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$branch\`
- Checkpoint: \`$(git rev-parse HEAD)\`
- Atomic migration claim: \`$claim_commit\`
- State: ${claim[1]}"
    end_issue_transaction
}

post_takeover_audit() {
    local issue="$1"
    local branch="$2"
    local previous_agent="$3"
    local previous_machine="$4"
    local previous_claim="$5"
    local replacement="$6"
    local base="$7"
    local reason="$8"
    post_once "$issue" "- New claim: \`$replacement\`" "### Claim takeover

- Previous agent: $previous_agent
- Previous machine: $previous_machine
- Workstream: \`$branch\`
- Previous claim: \`$previous_claim\`
- New agent: $agent_name
- New machine: $machine_name
- New claim: \`$replacement\`
- Recovered checkpoint: \`$base\`
- Reason: $reason"
}

takeover_work() {
    require_count 5 "$#"
    local issue="$1"
    local kind="$2"
    local slug="$3"
    local reason="$4"
    local expected="$5"
    local repository_root
    local worktree
    local branch
    local base
    local replacement
    local previous_agent
    local previous_machine
    local claim_ref_path
    local issue_state
    local remote_branch_commit
    local released_checkpoint
    validate_issue "$issue"
    validate_identity
    validate_workstream "$kind" "$slug"
    [[ "$expected" =~ ^[0-9a-f]{40,64}$ ]] || fail "expected claim must be a full Git object ID"
    [[ -n "$reason" && "$reason" != *$'\n'* ]] || fail "takeover reason must be one nonempty line"
    assert_issue_taxonomy "$issue"
    begin_issue_transaction "$issue" "take over $kind/$issue-$slug"
    repository_root="$(git rev-parse --show-toplevel)"
    worktree="$(worktree_path "$repository_root" "$issue" "$kind" "$slug")"
    branch="$(workstream_branch "$issue" "$kind" "$slug")"
    read_issue_state "$issue" issue_state
    if ! load_remote_claim "$issue" "$branch"; then
        if [[ "$issue_state" == "CLOSED" ]] && load_closed_cleanup_checkpoint "$issue" "$branch" "$expected" released_checkpoint; then
            load_remote_branch "$branch" remote_branch_commit
            [[ -z "$remote_branch_commit" || "$remote_branch_commit" == "$released_checkpoint" ]] || fail "workstream '$branch' branch and cleanup checkpoints differ"
            publish_terminal_projection "$issue" "$branch" "$released_checkpoint" Done
            end_issue_transaction
            printf 'closed issue #%s workstream %s was already released\n' "$issue" "$branch"
            return
        fi
        fail "workstream '$branch' has no atomic remote claim"
    fi
    if [[ "$issue_state" == "CLOSED" ]]; then
        [[ "$remote_claim_commit" == "$expected" ]] || fail "workstream '$branch' claim changed; expected $expected, found $remote_claim_commit"
        base="$remote_claim_checkpoint"
        load_remote_branch "$branch" remote_branch_commit
        if [[ -n "$remote_branch_commit" ]]; then
            git fetch origin "$branch"
            [[ "$(git rev-parse "origin/$branch")" == "$base" ]] || fail "workstream '$branch' branch and claim checkpoints differ"
        fi
        release_closed_start_claim "$issue" "$branch" "$base" "$expected" "$reason"
        end_issue_transaction
        printf 'released closed issue #%s workstream %s at %s\n' "$issue" "$branch" "$base"
        return
    fi
    if [[ "$remote_claim_commit" != "$expected" ]]; then
        if [[ "$remote_claim_agent" == "$agent_name" && "$remote_claim_machine" == "$machine_name" && "$remote_claim_branch" == "$branch" ]]; then
            [[ "$remote_claim_previous_claim" == "$expected" && -n "$remote_claim_previous_agent" && -n "$remote_claim_previous_machine" && -n "$remote_claim_takeover_reason" ]] || fail "workstream '$branch' is owned by this identity but is not the requested takeover"
            base="$(git rev-parse "refs/tl/claims/$issue/$(printf '%s' "$branch" | tr / -)^")"
            ensure_worktree "$worktree" "$branch" "$base"
            publish_claim "$issue" "$branch" "$worktree" "Recovered takeover: $reason" "In progress"
            post_takeover_audit "$issue" "$branch" "$remote_claim_previous_agent" "$remote_claim_previous_machine" "$remote_claim_previous_claim" "$remote_claim_commit" "$base" "$remote_claim_takeover_reason"
            end_issue_transaction
            printf '%s\n' "$worktree"
            return
        fi
        fail "workstream '$branch' claim changed; expected $expected, found $remote_claim_commit"
    fi
    previous_agent="$remote_claim_agent"
    previous_machine="$remote_claim_machine"
    claim_ref_path="$remote_claim_ref"
    base="$(git rev-parse "refs/tl/claims/$issue/$(printf '%s' "$branch" | tr / -)^")"
    load_remote_branch "$branch" remote_branch_commit
    if [[ -n "$remote_branch_commit" ]]; then
        git fetch origin "$branch"
        base="origin/$branch"
        [[ "$(git rev-parse "$base")" == "$remote_claim_checkpoint" ]] || fail "workstream '$branch' branch and claim checkpoints differ"
    fi
    publish_checkpoint_projection "$issue" "$branch" "$remote_claim_checkpoint" "$expected" "$previous_agent" "$previous_machine" "Checkpoint recovered before takeover" "remote claim parent and branch agree" "owner became unavailable"
    [[ ! -e "$worktree" ]] || fail "worktree already exists: $worktree"
    git show-ref --verify --quiet "refs/heads/$branch" && fail "local branch already exists: $branch"
    replacement="$(new_takeover_claim_commit "$issue" "$branch" "$base" "$previous_agent" "$previous_machine" "$expected" "$reason")"
    git push --force-with-lease="$claim_ref_path:$expected" origin "$replacement:$claim_ref_path" >/dev/null || fail "workstream '$branch' claim changed during takeover"
    remote_claim_commit="$replacement"
    ensure_worktree "$worktree" "$branch" "$base"
    publish_claim "$issue" "$branch" "$worktree" "Takeover: $reason" "In progress"
    post_takeover_audit "$issue" "$branch" "$previous_agent" "$previous_machine" "$expected" "$replacement" "$base" "$reason"
    end_issue_transaction
    printf '%s\n' "$worktree"
}

checkpoint_work() {
    require_count 3 "$#"
    local issue="$1"
    local summary="$2"
    local validation="$3"
    local risks="${4:-none reported}"
    local branch
    local commit
    validate_issue "$issue"
    validate_identity
    assert_clean
    begin_issue_transaction "$issue" "checkpoint $(git branch --show-current)"
    assert_claim "$issue"
    branch="$(git branch --show-current)"
    commit="$(git rev-parse HEAD)"
    publish_branch "$issue" "$branch" "$remote_claim_commit"
    publish_checkpoint_projection "$issue" "$branch" "$commit" "$remote_claim_commit" "$agent_name" "$machine_name" "$summary" "$validation" "$risks"
    end_issue_transaction
}

handoff_work() {
    require_count 3 "$#"
    local issue="$1"
    local remaining="$2"
    local next_command="$3"
    local item
    local branch
    local head
    local existing_claim
    local status
    local previous_status
    local remote_branch_commit
    local -a project=()
    validate_issue "$issue"
    validate_identity
    assert_clean
    assert_issue_open "$issue"
    branch="$(git branch --show-current)"
    head="$(git rev-parse HEAD)"
    begin_issue_transaction "$issue" "hand off $branch"
    load_claim_commit "$issue" "$branch" existing_claim
    if [[ -z "$existing_claim" ]]; then
        load_remote_branch "$branch" remote_branch_commit
        [[ "$remote_branch_commit" == "$head" ]] || fail "the handed-off checkpoint is not the remote branch head"
        gh issue view "$issue" --json comments --jq '.comments[].body' | grep -Fq -- "- Handoff checkpoint: \`$head\`" || fail "workstream '$branch' has no durable handoff record at $head"
        item="$(project_item "$issue")"
        set_text "$item" Agent "$agent_name"
        set_text "$item" Machine "$machine_name"
        set_text "$item" Branch "$branch"
        set_text "$item" Checkpoint "$head"
        if has_other_active_claims "$issue" ""; then
            status="In progress"
        else
            status="Ready"
        fi
        set_status "$item" "$status"
        end_issue_transaction
        printf 'workstream %s is already handed off at %s\n' "$branch" "$head"
        return
    fi
    assert_claim "$issue" handoff
    load_project_claim "$issue" project
    previous_status="${project[1]}"
    load_remote_branch "$branch" remote_branch_commit
    if [[ "$remote_claim_checkpoint" != "$head" || -z "$remote_branch_commit" ]]; then
        publish_branch "$issue" "$branch" "$remote_claim_commit"
    else
        assert_claimed_checkpoint "$branch" "$head"
    fi
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$head"
    if has_other_active_claims "$issue" "$remote_claim_ref"; then
        status="In progress"
    else
        status="Ready"
    fi
    set_status "$item" "$status"
    post_once "$issue" "- Handoff claim: \`$remote_claim_commit\`" "### Handoff

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$branch\`
- Handoff checkpoint: \`$head\`
- Handoff claim: \`$remote_claim_commit\`
- Remaining work: $remaining
- Exact next command: \`$next_command\`
- State: $status"
    if ! release_claim "$issue" "$branch" "$remote_claim_commit"; then
        set_status "$item" "$previous_status"
        fail "workstream '$branch' claim changed before release"
    fi
    end_issue_transaction
}

open_pr() {
    require_count 3 "$#"
    local issue="$1"
    local title="$2"
    local body_file="$3"
    local branch
    local item
    local pr_url
    validate_issue "$issue"
    validate_identity
    [[ -f "$body_file" ]] || fail "pull request body file does not exist"
    grep -Eiq "^(Closes|Fixes|Resolves|Refs)[[:space:]]+#$issue([[:space:]]|$)" "$body_file" || fail "pull request body must link issue #$issue with Closes, Fixes, Resolves, or Refs"
    assert_clean
    begin_issue_transaction "$issue" "open pull request for $(git branch --show-current)"
    assert_claim "$issue"
    branch="$(git branch --show-current)"
    publish_branch "$issue" "$branch" "$remote_claim_commit"
    pr_url="$(gh pr list --base main --head "$branch" --state open --json url --jq '.[0].url // ""')"
    if [[ -z "$pr_url" ]]; then
        pr_url="$(gh pr create --base main --head "$branch" --title "$title" --body-file "$body_file")"
    fi
    gh project item-add "$project_number" --owner "$repository_owner" --url "$pr_url" >/dev/null
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$(git rev-parse HEAD)"
    set_status "$item" "In review"
    end_issue_transaction
    printf '%s\n' "$pr_url"
}

merged_pr_for_claim() {
    local issue="$1"
    local branch="$2"
    local head="$3"
    local pr
    local state
    local pr_branch
    local pr_head
    local merge_commit
    local body
    local linked
    linked="$(gh pr list --head "$branch" --state merged --json number --jq '.[].number')" || fail "could not read merged pull requests for workstream '$branch'"
    while read -r pr; do
        [[ -n "$pr" ]] || continue
        state="$(gh pr view "$pr" --json state --jq .state)"
        pr_branch="$(gh pr view "$pr" --json headRefName --jq .headRefName)"
        pr_head="$(gh pr view "$pr" --json headRefOid --jq .headRefOid)"
        merge_commit="$(gh pr view "$pr" --json mergeCommit --jq '.mergeCommit.oid // ""')"
        body="$(gh pr view "$pr" --json body --jq .body)"
        if [[ "$state" == "MERGED" && "$pr_branch" == "$branch" && "$pr_head" == "$head" && -n "$merge_commit" ]] &&
            grep -Eiq "^(Closes|Fixes|Resolves|Refs)[[:space:]]+#$issue([[:space:]]|$)" <<<"$body"; then
            git merge-base --is-ancestor "$merge_commit" origin/main && { printf '%s\n' "$pr"; return 0; }
        fi
    done <<<"$linked"
    return 1
}

finish_work() {
    require_count 2 "$#"
    local issue="$1"
    local evidence="$2"
    local item
    local branch
    local head
    local pr
    local state
    local existing_claim
    local previous_status
    local remote_branch_commit
    local -a project=()
    validate_issue "$issue"
    validate_identity
    assert_clean
    branch="$(git branch --show-current)"
    head="$(git rev-parse HEAD)"
    begin_issue_transaction "$issue" "complete $branch"
    git fetch origin main
    load_claim_commit "$issue" "$branch" existing_claim
    if [[ -z "$existing_claim" ]]; then
        load_remote_branch "$branch" remote_branch_commit
        [[ "$remote_branch_commit" == "$head" ]] || fail "local HEAD $head is not the remote branch checkpoint"
        pr="$(merged_pr_for_claim "$issue" "$branch" "$head")" || fail "issue #$issue has no linked merged PR for branch '$branch' at commit $head"
        gh issue view "$issue" --json comments --jq '.comments[].body' | grep -Fq -- "Merged by #$pr." || fail "workstream '$branch' has no durable completion record for PR #$pr"
        item="$(project_item "$issue")"
        set_text "$item" Agent "$agent_name"
        set_text "$item" Machine "$machine_name"
        set_text "$item" Branch "$branch"
        set_text "$item" Checkpoint "$head"
        state="$(gh issue view "$issue" --json state --jq .state)"
        if has_other_active_claims "$issue" ""; then
            set_status "$item" "In progress"
        elif [[ "$state" == "CLOSED" ]]; then
            set_status "$item" Done
        else
            set_status "$item" Ready
        fi
        end_issue_transaction
        printf 'workstream %s is complete through PR #%s\n' "$branch" "$pr"
        return
    fi
    assert_claim "$issue" completion
    load_project_claim "$issue" project
    previous_status="${project[1]}"
    assert_claimed_checkpoint "$branch" "$head"
    pr="$(merged_pr_for_claim "$issue" "$branch" "$head")" || fail "issue #$issue has no linked merged PR for branch '$branch' at commit $head"
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$head"
    state="$(gh issue view "$issue" --json state --jq .state)"
    post_once "$issue" "Merged by #$pr." "$evidence Merged by #$pr."
    if has_other_active_claims "$issue" "$remote_claim_ref"; then
        set_status "$item" "In progress"
    elif [[ "$state" == "CLOSED" ]]; then
        set_status "$item" Done
    else
        set_status "$item" Ready
    fi
    if ! release_claim "$issue" "$branch" "$remote_claim_commit"; then
        set_status "$item" "$previous_status"
        fail "workstream '$branch' claim changed before release"
    fi
    end_issue_transaction
}

usage() {
    printf '%s\n' \
        "eng/agent-work issue <title> <area-label> <kind-label> <body-file> [milestone]" \
        "eng/agent-work start <issue> <kind> <slug> <scope> [base]" \
        "eng/agent-work adopt <issue>" \
        "eng/agent-work recover-lock <issue> <expected-transaction> <reason>" \
        "eng/agent-work takeover <issue> <kind> <slug> <reason> <expected-claim>" \
        "eng/agent-work checkpoint <issue> <summary> <validation> [risks]" \
        "eng/agent-work handoff <issue> <remaining> <next-command>" \
        "eng/agent-work pr <issue> <title> <body-file>" \
        "eng/agent-work done <issue> <evidence>"
}

command="${1:-}"
[[ -n "$command" ]] || { usage; exit 2; }
shift
initialize_github

case "$command" in
    issue) create_issue "$@" ;;
    start) start_work "$@" ;;
    adopt) adopt_work "$@" ;;
    recover-lock) recover_issue_transaction "$@" ;;
    takeover) takeover_work "$@" ;;
    checkpoint) checkpoint_work "$@" ;;
    handoff) handoff_work "$@" ;;
    pr) open_pr "$@" ;;
    done) finish_work "$@" ;;
    *) usage; exit 2 ;;
esac
