#!/usr/bin/env bash
set -euo pipefail

project_number="${TL_PROJECT_NUMBER:-6}"
agent_name="${TL_AGENT:-${USER:-agent}}"
machine_name="${TL_MACHINE:-$(hostname)}"

fail() {
    printf '%s\n' "$1" >&2
    exit 2
}

require_count() {
    [[ "$2" -ge "$1" ]] || fail "missing arguments"
}

validate_issue() {
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || fail "issue must be a positive integer"
}

validate_identity() {
    [[ "$agent_name" != *$'\n'* && "$agent_name" != *'|'* && -n "$agent_name" ]] || fail "TL_AGENT must be one nonempty line without pipes"
    [[ "$machine_name" != *$'\n'* && "$machine_name" != *'|'* && -n "$machine_name" ]] || fail "TL_MACHINE must be one nonempty line without pipes"
}

owner() {
    gh repo view --json owner --jq .owner.login
}

issue_url() {
    gh issue view "$1" --json url --jq .url
}

project_id() {
    gh project view "$project_number" --owner "$(owner)" --format json --jq .id
}

project_item() {
    gh project item-add "$project_number" --owner "$(owner)" --url "$(issue_url "$1")" --format json --jq .id
}

project_claim() {
    gh project item-list "$project_number" --owner "$(owner)" --format json --limit 1000 \
        --jq ".items[] | select(.content.number == $1 and .content.type == \"Issue\") | [.id, (.stage // \"\"), (.agent // \"\"), (.machine // \"\"), (.branch // \"\"), (.checkpoint // \"\")] | .[]"
}

load_project_claim() {
    local issue="$1"
    local target="$2"
    local output
    local -n values="$target"
    output="$(project_claim "$issue")" || fail "could not read issue #$issue from Project $project_number"
    values=()
    if [[ -n "$output" ]]; then
        mapfile -t values <<<"$output"
    fi
}

field_id() {
    gh project field-list "$project_number" --owner "$(owner)" --format json --jq ".fields[] | select(.name == \"$1\") | .id"
}

stage_id() {
    gh project field-list "$project_number" --owner "$(owner)" --format json --jq ".fields[] | select(.name == \"Stage\") | .options[] | select(.name == \"$1\") | .id"
}

set_text() {
    gh project item-edit --id "$1" --project-id "$(project_id)" --field-id "$(field_id "$2")" --text "$3" >/dev/null
}

set_stage() {
    gh project item-edit --id "$1" --project-id "$(project_id)" --field-id "$(field_id Stage)" --single-select-option-id "$(stage_id "$2")" >/dev/null
}

post() {
    local body
    body="$(mktemp)"
    printf '%s\n' "$2" >"$body"
    if gh issue comment "$1" --body-file "$body"; then
        rm -f "$body"
    else
        local status="$?"
        rm -f "$body"
        return "$status"
    fi
}

create_issue() {
    require_count 4 "$#"
    local title="$1"
    local area="$2"
    local kind="$3"
    local body_file="$4"
    local milestone="${5:-}"
    local url
    local issue
    local item
    [[ "$area" =~ ^area:[a-z0-9-]+$ ]] || fail "area label must use area:<name>"
    [[ "$kind" =~ ^kind:[a-z0-9-]+$ ]] || fail "kind label must use kind:<name>"
    [[ -f "$body_file" ]] || fail "issue body file does not exist"
    if [[ -n "$milestone" ]]; then
        url="$(gh issue create --title "$title" --body-file "$body_file" --label ai --label "$area" --label "$kind" --milestone "$milestone")"
    else
        url="$(gh issue create --title "$title" --body-file "$body_file" --label ai --label "$area" --label "$kind")"
    fi
    issue="${url##*/}"
    validate_issue "$issue"
    item="$(project_item "$issue")"
    set_stage "$item" Ready
    printf '%s\n' "$url"
}

assert_clean() {
    [[ -z "$(git status --porcelain)" ]] || fail "commit the owned changes before publishing a checkpoint"
}

assert_issue_open() {
    [[ "$(gh issue view "$1" --json state --jq .state)" == "OPEN" ]] || fail "issue #$1 is not open"
}

assert_issue_taxonomy() {
    local labels
    labels="$(gh issue view "$1" --json labels --jq '[.labels[].name] | join("\n")')"
    grep -Fxq ai <<<"$labels" || fail "issue #$1 must have the ai label"
    grep -Eq '^area:' <<<"$labels" || fail "issue #$1 must have an area:* label"
    grep -Eq '^kind:' <<<"$labels" || fail "issue #$1 must have a kind:* label"
}

assert_assigned() {
    local login
    login="$(gh api user --jq .login)"
    gh issue view "$1" --json assignees --jq '.assignees[].login' | grep -Fxq "$login" || fail "issue #$1 is not assigned to $login"
}

agent_slug() {
    local slug
    slug="$(tr '[:upper:]_' '[:lower:]-' <<<"$agent_name" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
    [[ -n "$slug" ]] || fail "TL_AGENT does not contain a branch-safe identity"
    printf '%s\n' "$slug"
}

claim_ref() {
    printf 'refs/heads/claims/%s\n' "$1"
}

read_claim_commit() {
    git ls-remote --exit-code --heads origin "$(claim_ref "$1")" 2>/dev/null | awk 'NR == 1 { print $1 }'
}

claim_message() {
    git fetch --quiet origin "+$(claim_ref "$1"):refs/tl/claims/$1"
    git show -s --format=%B "refs/tl/claims/$1"
}

acquire_claim() {
    local issue="$1"
    local branch="$2"
    local base="$3"
    local message
    local commit
    [[ -z "$(read_claim_commit "$issue" || true)" ]] || fail "issue #$issue already has an atomic remote claim"
    message="issue=$issue
agent=$agent_name
machine=$machine_name
branch=$branch
nonce=$(date -u +%Y%m%dT%H%M%S%N)-$$"
    commit="$(printf '%s\n' "$message" | git commit-tree "$(git rev-parse "$base^{tree}")" -p "$base")"
    git push origin "$commit:$(claim_ref "$issue")" >/dev/null || fail "issue #$issue was claimed concurrently"
    printf '%s\n' "$commit"
}

release_claim() {
    local issue="$1"
    local commit
    commit="$(read_claim_commit "$issue")" || fail "issue #$issue has no atomic remote claim"
    git push --force-with-lease="$(claim_ref "$issue"):$commit" origin ":$(claim_ref "$issue")" >/dev/null
}

assert_claim() {
    local issue="$1"
    local allow_closed="${2:-false}"
    local branch
    local message
    local -a claim=()
    branch="$(git branch --show-current)"
    load_project_claim "$issue" claim
    [[ "${#claim[@]}" -eq 6 ]] || fail "issue #$issue is not attached to Project $project_number"
    [[ "${claim[1]}" == "In progress" || "${claim[1]}" == "In review" ]] || fail "issue #$issue is not actively claimed"
    [[ "${claim[2]}" == "$agent_name" ]] || fail "issue #$issue is claimed by agent '${claim[2]}'"
    [[ "${claim[3]}" == "$machine_name" ]] || fail "issue #$issue is claimed on machine '${claim[3]}'"
    [[ "${claim[4]}" == "$branch" ]] || fail "issue #$issue owns branch '${claim[4]}', not '$branch'"
    message="$(claim_message "$issue")"
    grep -Fxq "issue=$issue" <<<"$message" || fail "remote claim issue mismatch"
    grep -Fxq "agent=$agent_name" <<<"$message" || fail "remote claim agent mismatch"
    grep -Fxq "machine=$machine_name" <<<"$message" || fail "remote claim machine mismatch"
    grep -Fxq "branch=$branch" <<<"$message" || fail "remote claim branch mismatch"
    if [[ "$allow_closed" != "true" ]]; then
        assert_issue_open "$issue"
    fi
    assert_issue_taxonomy "$issue"
    assert_assigned "$issue"
}

start_work() {
    require_count 3 "$#"
    local issue="$1"
    local slug="$2"
    local scope="$3"
    local repository_root
    local worktree
    local branch
    local base
    local item
    local claim_commit
    local -a claim=()
    validate_issue "$issue"
    validate_identity
    [[ "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "slug must contain lowercase words separated by hyphens"
    assert_issue_open "$issue"
    assert_issue_taxonomy "$issue"
    load_project_claim "$issue" claim
    if [[ "${#claim[@]}" -ne 0 && "${#claim[@]}" -ne 6 ]]; then
        fail "issue #$issue has an unreadable Project claim"
    fi
    if [[ "${#claim[@]}" -eq 6 && ( "${claim[1]}" == "In progress" || "${claim[1]}" == "In review" ) ]]; then
        fail "issue #$issue is already claimed by ${claim[2]:-unknown} on ${claim[3]:-unknown} using ${claim[4]:-unknown}"
    fi
    repository_root="$(git rev-parse --show-toplevel)"
    worktree="$(dirname "$repository_root")/tl-issue-$issue-$slug-$(agent_slug)"
    branch="ai/$issue-$slug-$(agent_slug)"
    [[ ! -e "$worktree" ]] || fail "worktree already exists: $worktree"
    git fetch origin main
    base="origin/main"
    if [[ "${#claim[@]}" -eq 6 && -n "${claim[4]}" && -n "${claim[5]}" ]]; then
        git fetch origin "${claim[4]}"
        [[ "$(git rev-parse "origin/${claim[4]}")" == "${claim[5]}" ]] || fail "ready handoff checkpoint does not match its remote branch"
        base="origin/${claim[4]}"
    fi
    claim_commit="$(acquire_claim "$issue" "$branch" "$base")"
    if ! git worktree add "$worktree" -b "$branch" "$base"; then
        git push --force-with-lease="$(claim_ref "$issue"):$claim_commit" origin ":$(claim_ref "$issue")" >/dev/null || true
        fail "could not create the claimed worktree"
    fi
    gh issue edit "$issue" --add-assignee "@me" >/dev/null
    item="$(project_item "$issue")"
    set_text "$item" Agent "$agent_name"
    set_text "$item" Machine "$machine_name"
    set_text "$item" Branch "$branch"
    set_text "$item" Checkpoint "$(git -C "$worktree" rev-parse HEAD)"
    set_stage "$item" "In progress"
    post "$issue" "### Work claim

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$branch\`
- Worktree: \`$worktree\`
- Base: \`$(git -C "$worktree" rev-parse HEAD)\`
- Claim: \`$claim_commit\`
- Scope: $scope
- State: In progress"
    printf '%s\n' "$worktree"
}

checkpoint_work() {
    require_count 3 "$#"
    local issue="$1"
    local summary="$2"
    local validation="$3"
    local risks="${4:-none reported}"
    local branch
    local commit
    local item
    validate_issue "$issue"
    validate_identity
    assert_clean
    assert_claim "$issue"
    branch="$(git branch --show-current)"
    commit="$(git rev-parse HEAD)"
    git push --set-upstream origin HEAD
    item="$(project_item "$issue")"
    set_text "$item" Checkpoint "$commit"
    set_stage "$item" "In progress"
    post "$issue" "### Green checkpoint

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$branch\`
- Commit: \`$commit\`
- Result: $summary
- Validation: $validation
- Remaining risks: $risks"
}

handoff_work() {
    require_count 3 "$#"
    local issue="$1"
    local remaining="$2"
    local next_command="$3"
    local item
    validate_issue "$issue"
    checkpoint_work "$issue" "Handoff checkpoint" "working tree clean and commit pushed" "$remaining"
    item="$(project_item "$issue")"
    set_stage "$item" Ready
    post "$issue" "### Handoff

- Agent: $agent_name
- Machine: $machine_name
- Branch: \`$(git branch --show-current)\`
- Commit: \`$(git rev-parse HEAD)\`
- Remaining work: $remaining
- Exact next command: \`$next_command\`
- State: Ready"
    release_claim "$issue"
}

open_pr() {
    require_count 3 "$#"
    local issue="$1"
    local title="$2"
    local body_file="$3"
    local branch
    local item
    local pr_url
    validate_issue "$issue"
    validate_identity
    [[ -f "$body_file" ]] || fail "pull request body file does not exist"
    grep -Eq "^Closes[[:space:]]+#$issue([[:space:]]|$)" "$body_file" || fail "pull request body must contain 'Closes #$issue'"
    assert_clean
    assert_claim "$issue"
    branch="$(git branch --show-current)"
    git push --set-upstream origin HEAD
    pr_url="$(gh pr create --base main --head "$branch" --title "$title" --body-file "$body_file")"
    gh project item-add "$project_number" --owner "$(owner)" --url "$pr_url" >/dev/null
    item="$(project_item "$issue")"
    set_stage "$item" "In review"
    set_text "$item" Checkpoint "$(git rev-parse HEAD)"
    printf '%s\n' "$pr_url"
}

merged_pr_for_claim() {
    local issue="$1"
    local branch="$2"
    local head="$3"
    local pr
    local state
    local pr_branch
    local pr_head
    local merge_commit
    local linked
    linked="$(gh issue view "$issue" --json closedByPullRequestsReferences --jq '.closedByPullRequestsReferences[].number')" || fail "could not read linked pull requests for issue #$issue"
    while read -r pr; do
        [[ -n "$pr" ]] || continue
        state="$(gh pr view "$pr" --json state --jq .state)"
        pr_branch="$(gh pr view "$pr" --json headRefName --jq .headRefName)"
        pr_head="$(gh pr view "$pr" --json headRefOid --jq .headRefOid)"
        merge_commit="$(gh pr view "$pr" --json mergeCommit --jq '.mergeCommit.oid // ""')"
        if [[ "$state" == "MERGED" && "$pr_branch" == "$branch" && "$pr_head" == "$head" && -n "$merge_commit" ]]; then
            git merge-base --is-ancestor "$merge_commit" origin/main && { printf '%s\n' "$pr"; return 0; }
        fi
    done <<<"$linked"
    return 1
}

finish_work() {
    require_count 2 "$#"
    local issue="$1"
    local evidence="$2"
    local item
    local branch
    local head
    local pr
    local state
    validate_issue "$issue"
    validate_identity
    assert_clean
    assert_claim "$issue" true
    branch="$(git branch --show-current)"
    head="$(git rev-parse HEAD)"
    git fetch origin main
    pr="$(merged_pr_for_claim "$issue" "$branch" "$head")" || fail "issue #$issue has no linked merged PR for branch '$branch' at commit $head"
    item="$(project_item "$issue")"
    set_stage "$item" Done
    set_text "$item" Checkpoint "$head"
    state="$(gh issue view "$issue" --json state --jq .state)"
    if [[ "$state" == "OPEN" ]]; then
        gh issue close "$issue" --comment "$evidence Merged by #$pr."
    else
        post "$issue" "$evidence Merged by #$pr."
    fi
    release_claim "$issue"
}

usage() {
    printf '%s\n' \
        "eng/agent-work issue <title> <area-label> <kind-label> <body-file> [milestone]" \
        "eng/agent-work start <issue> <slug> <scope>" \
        "eng/agent-work checkpoint <issue> <summary> <validation> [risks]" \
        "eng/agent-work handoff <issue> <remaining> <next-command>" \
        "eng/agent-work pr <issue> <title> <body-file>" \
        "eng/agent-work done <issue> <evidence>"
}

command="${1:-}"
[[ -n "$command" ]] || { usage; exit 2; }
shift

case "$command" in
    issue) create_issue "$@" ;;
    start) start_work "$@" ;;
    checkpoint) checkpoint_work "$@" ;;
    handoff) handoff_work "$@" ;;
    pr) open_pr "$@" ;;
    done) finish_work "$@" ;;
    *) usage; exit 2 ;;
esac
