#!/usr/bin/env bash
set -euo pipefail

[[ "$#" -le 1 ]] || { printf '%s\n' "usage: eng/test-unity-player [empty-output-directory]" >&2; exit 2; }

root="$(git rev-parse --show-toplevel)"
temporary=false
if [[ "$#" -eq 0 ]]; then
    stage="$(mktemp -d /tmp/tl-unity-player.XXXXXX)"
    temporary=true
else
    [[ ! -e "$1" ]] || { printf '%s\n' "output already exists: $1" >&2; exit 2; }
    mkdir -p "$1"
    stage="$(cd "$1" && pwd)"
fi

cleanup() {
    if "$temporary"; then
        rm -rf -- "$stage"
    fi
}
trap cleanup EXIT

project="$root/tests/Tl.Unity.Project"
player="$stage/TlUnityPlayer"
build_log="$stage/build.log"
player_log="$stage/player.log"
symbols="$stage/burst-symbols.txt"

if ! unity --no-banner --format json build "$project" \
    --target StandaloneLinux64 \
    --execute-method TlUnityBuild.Build \
    --output-path "$player" \
    --log-file "$build_log" \
    --no-tail; then
    tail -200 "$build_log" >&2
    exit 1
fi

mapfile -t burst_libraries < <(find "${player}_Data" -type f -name 'lib_burst_generated.so' -print)
[[ "${#burst_libraries[@]}" -eq 1 ]] || { printf '%s\n' "expected one Burst library, found ${#burst_libraries[@]}" >&2; exit 2; }
nm -D -C "${burst_libraries[0]}" >"$symbols"
grep -Fq 'TlUnity.PlayerProbe.AdvanceGateJob' "$symbols" || { printf '%s\n' "Burst output does not contain AdvanceGateJob" >&2; exit 2; }
grep -Fq 'Tl.Samples.BurstCombat.AdvanceAttackJob' "$symbols" || { printf '%s\n' "Burst output does not contain AdvanceAttackJob" >&2; exit 2; }

forbidden="$(find "$stage" -type f \( \
    -name 'Tl.Compiler*' -o \
    -name 'Tl.Gen*' -o \
    -name 'Microsoft.CodeAnalysis*' \
    \) -print)"
[[ -z "$forbidden" ]] || { printf '%s\n' "player contains forbidden toolchain assemblies:" "$forbidden" >&2; exit 2; }

timeout 60 "$player" -batchmode -nographics -logFile - | tee "$player_log"
grep -Fq 'TL_UNITY_PLAYER_OK' "$player_log" || { printf '%s\n' "player did not print TL_UNITY_PLAYER_OK" >&2; exit 2; }

printf '%s\n' "Unity player gate passed: $stage"
