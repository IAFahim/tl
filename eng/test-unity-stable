#!/usr/bin/env bash
set -euo pipefail

[[ "$#" -le 1 ]] || { printf '%s\n' "usage: eng/test-unity-stable [empty-output-directory]" >&2; exit 2; }

root="$(git rev-parse --show-toplevel)"
project="$root/tests/Tl.Unity.Project"
temporary=false
if [[ "$#" -eq 0 ]]; then
    receipt="$(mktemp -d /tmp/tl-unity-stable-receipt.XXXXXX)"
    temporary=true
else
    [[ ! -e "$1" ]] || { printf '%s\n' "output already exists: $1" >&2; exit 2; }
    mkdir -p "$1"
    receipt="$(cd "$1" && pwd)"
fi
stage="$(mktemp -d /tmp/tl-unity-stable-project.XXXXXX)"
cache="${TL_UNITY_STABLE_CACHE:-/tmp/tl-unity-stable-cache}"
mkdir -p "$cache"

cleanup() {
    rm -rf -- "$stage"
    if "$temporary"; then
        rm -rf -- "$receipt"
    fi
}
trap cleanup EXIT

fetch() {
    local url="$1"
    local archive="$2"
    local expected="$3"
    local actual
    actual="$(test -f "$archive" && sha256sum "$archive" | cut -d' ' -f1 || true)"
    if [[ "$actual" != "$expected" ]]; then
        curl -L --fail --silent --show-error "$url" -o "$archive.download"
        mv "$archive.download" "$archive"
        actual="$(sha256sum "$archive" | cut -d' ' -f1)"
    fi
    [[ "$actual" == "$expected" ]] || { printf '%s\n' "hash mismatch for $url: $actual" >&2; exit 2; }
}

packages="$stage/packages"
stable="$stage/project"
mkdir -p "$packages/entities" "$packages/sbp" "$stable/Assets/Plugins/Editor"
fetch "https://packages.unity.com/com.unity.entities/-/com.unity.entities-1.4.3.tgz" "$cache/entities-1.4.3.tgz" "dbaa426d873d3302d764ccfb8d0257d1e845ee3168f76694a539c31175ad0254"
fetch "https://packages.unity.com/com.unity.scriptablebuildpipeline/-/com.unity.scriptablebuildpipeline-1.21.25.tgz" "$cache/sbp-1.21.25.tgz" "1b4ff6e04ab8ce9b2c6addc642a28f68c5b4b0f505f316669597e3c5ebb4243a"
fetch "https://api.nuget.org/v3-flatcontainer/system.io.hashing/8.0.0/system.io.hashing.8.0.0.nupkg" "$cache/hashing-8.0.0.nupkg" "b33386b744cd068e9d11d0b781fe87f9ef585b7370d30a1ae949c218618ae5c1"
fetch "https://api.nuget.org/v3-flatcontainer/system.runtime.compilerservices.unsafe/6.0.0/system.runtime.compilerservices.unsafe.6.0.0.nupkg" "$cache/unsafe-6.0.0.nupkg" "6c41b53e70e9eee298cff3a02ce5acdd15b04125589be0273f0566026720a762"
tar -xzf "$cache/entities-1.4.3.tgz" --strip-components=1 -C "$packages/entities"
tar -xzf "$cache/sbp-1.21.25.tgz" --strip-components=1 -C "$packages/sbp"
"$project/materialize-alpha3.sh"
rsync -a --exclude Library --exclude Packages/packages-lock.json "$project/" "$stable/"
cp "$stable/Packages/manifest.stable.json" "$stable/Packages/manifest.json"
unzip -p "$cache/hashing-8.0.0.nupkg" lib/netstandard2.0/System.IO.Hashing.dll > "$stable/Assets/Plugins/Editor/System.IO.Hashing.dll"
unzip -p "$cache/unsafe-6.0.0.nupkg" lib/netstandard2.0/System.Runtime.CompilerServices.Unsafe.dll > "$stable/Assets/Plugins/Editor/System.Runtime.CompilerServices.Unsafe.dll"
python3 - "$stable/Packages/manifest.json" "$root/src/Tl.Unity" "$packages/entities" "$packages/sbp" <<'PY'
import json
import sys
path, runtime, entities, sbp = sys.argv[1:]
with open(path, encoding="utf-8") as stream:
    manifest = json.load(stream)
dependencies = manifest["dependencies"]
dependencies["com.iafahim.tl"] = "file:" + runtime
dependencies["com.unity.entities"] = "file:" + entities
dependencies["com.unity.scriptablebuildpipeline"] = "file:" + sbp
with open(path, "w", encoding="utf-8", newline="\n") as stream:
    json.dump(manifest, stream, indent=2)
    stream.write("\n")
PY
printf '%s\n' \
    'm_EditorVersion: 6000.0.83f1' \
    'm_EditorVersionWithRevision: 6000.0.83f1 (dacc44548933)' \
    > "$stable/ProjectSettings/ProjectVersion.txt"

run_test() {
    local mode="$1"
    local output="$2"
    local log="$stage/${mode}.log"
    unity --no-banner --format json --non-interactive test "$stable" \
        --editor-version 6000.0.83f1 \
        --mode "$mode" \
        --output "$output" \
        --timeout 900 \
        -- -nographics >"$log" 2>&1 || { tail -200 "$log" >&2; exit 1; }
    if rg -n "compiler errors|will not be loaded due to errors|error CS|Tundra build failed" "$log"; then
        exit 2
    fi
}

run_test EditMode "$receipt/editmode.xml"
run_test PlayMode "$receipt/playmode.xml"
python3 - "$stable/Packages/packages-lock.json" "$receipt/packages.txt" "$receipt/editmode.xml" "$receipt/playmode.xml" <<'PY'
import json
import sys
import xml.etree.ElementTree as ET
lock, output, edit, play = sys.argv[1:]
with open(lock, encoding="utf-8") as stream:
    packages = json.load(stream)["dependencies"]
lines = [
    "unity\t6000.0.83f1\tdacc44548933",
    "entities\t1.4.3\tdbaa426d873d3302d764ccfb8d0257d1e845ee3168f76694a539c31175ad0254",
    "burst\t" + packages["com.unity.burst"]["version"],
    "collections\t" + packages["com.unity.collections"]["version"],
    "mathematics\t" + packages["com.unity.mathematics"]["version"],
    "scriptable-build-pipeline\t1.21.25\t1b4ff6e04ab8ce9b2c6addc642a28f68c5b4b0f505f316669597e3c5ebb4243a",
    "system-io-hashing\t8.0.0\tb33386b744cd068e9d11d0b781fe87f9ef585b7370d30a1ae949c218618ae5c1",
    "unsafe\t6.0.0\t6c41b53e70e9eee298cff3a02ce5acdd15b04125589be0273f0566026720a762",
]
for name, path in (("editmode", edit), ("playmode", play)):
    result = ET.parse(path).getroot().attrib
    lines.append("\t".join((name, result["result"], result["passed"], result["total"])))
with open(output, "w", encoding="utf-8", newline="\n") as stream:
    stream.write("\n".join(lines) + "\n")
print("; ".join(lines))
PY

printf '%s\n' "Unity stable gate passed: $receipt"
