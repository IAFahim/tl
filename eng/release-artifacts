#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
reference="${2:-}"
output="${3:-}"

[[ "$mode" == "--candidate" || "$mode" == "--tag" ]] || { printf '%s\n' "usage: eng/release-artifacts (--candidate <name> | --tag <tag>) <empty-output-directory>" >&2; exit 2; }
[[ -n "$reference" && -n "$output" ]] || { printf '%s\n' "usage: eng/release-artifacts (--candidate <name> | --tag <tag>) <empty-output-directory>" >&2; exit 2; }
[[ ! -e "$output" ]] || { printf '%s\n' "output already exists: $output" >&2; exit 2; }

root="$(git rev-parse --show-toplevel)"
head_commit="$(git rev-parse HEAD)"
source_epoch="$(git -C "$root" show -s --format=%ct HEAD)"
version="$(dotnet msbuild "$root/src/Tl.Core/Tl.Core.csproj" -getProperty:Version -nologo)"
sdk="$(dotnet --version)"
runtime_identifier="linux-x64"

worktree_status="$(git -C "$root" status --porcelain --untracked-files=all)"
[[ -z "$worktree_status" ]] || { printf '%s\n' "release input contains tracked or untracked changes" >&2; printf '%s\n' "$worktree_status" >&2; exit 2; }

if [[ "$mode" == "--tag" ]]; then
    tag_commit="$("$root/eng/release-ref" "$reference" "$version")"
    [[ "$tag_commit" == "$head_commit" ]]
    phase="tagged"
    tag="$reference"
    repository_ref="refs/tags/$reference"
else
    phase="candidate"
    tag="$reference"
    if [[ -n "${GITHUB_REF:-}" ]]; then
        repository_ref="$GITHUB_REF"
        git check-ref-format "$repository_ref" >/dev/null
    else
        branch="$(git -C "$root" branch --show-current)"
        [[ -n "$branch" ]] || { printf '%s\n' "candidate artifacts require a named branch or GITHUB_REF" >&2; exit 2; }
        git check-ref-format --branch "$branch" >/dev/null
        repository_ref="refs/heads/$branch"
    fi
fi

stage="$(mktemp -d /tmp/tl-release-artifacts.XXXXXX)"
trap 'rm -rf -- "$stage"' EXIT
mkdir -p "$stage/raw-a" "$stage/raw-b"
export NUGET_PACKAGES="$stage/nuget"
path_map="$root=/_/%2C$stage=/_release/"

properties=(
    -p:ContinuousIntegrationBuild=true
    -p:RepositoryCommit="$head_commit"
    -p:RepositoryBranch="$repository_ref"
    -p:NuGetAudit=false
    -p:PathMap="$path_map"
)
projects=(
    src/Tl.Core/Tl.Core.csproj
    src/Tl.Gen/Tl.Gen.csproj
    src/Tl.Compiler/Tl.Compiler.csproj
    src/Tl.Gen.C/Tl.Gen.C.csproj
    src/Tl.CSharp/Tl.CSharp.csproj
)

solution_artifacts="$stage/solution-artifacts"
solution_properties=(
    "${properties[@]}"
    -p:TlGenAssembly="$solution_artifacts/bin/Tl.Gen/release/Tl.Gen.dll"
    -p:TlGenPackOutput="$solution_artifacts/bin/Tl.Gen/release/"
)
dotnet restore "$root/tl.slnx" -p:NuGetAudit=false --artifacts-path "$solution_artifacts"
dotnet build "$root/tl.slnx" -c Release -m:1 --no-restore --artifacts-path "$solution_artifacts" "${solution_properties[@]}"

for package_pass in raw-a raw-b; do
    for project in "${projects[@]}"; do
        dotnet pack "$root/$project" -c Release --no-build --no-restore -m:1 --artifacts-path "$solution_artifacts" -o "$stage/$package_pass" "${solution_properties[@]}"
    done
    python3 "$root/eng/release_artifacts.py" canonicalize "$stage/$package_pass" "$stage/$package_pass-normalized"
done

for artifact in "$stage/raw-a-normalized"/*; do
    name="${artifact##*/}"
    cmp "$artifact" "$stage/raw-b-normalized/$name"
done

mkdir -p "$(dirname -- "$output")"
mkdir "$output"
cp "$stage/raw-a-normalized"/* "$output/"
python3 "$root/eng/release_artifacts.py" verify "$output" "$version" "$head_commit" "$repository_ref"

consumer="$root/tests/Tl.PackageConsumer/Tl.PackageConsumer.csproj"
consumer_artifacts="$stage/consumer-artifacts"
dotnet restore "$consumer" --force --no-cache --source "$output" --artifacts-path "$consumer_artifacts"
dotnet build "$consumer" -c Release --no-restore --artifacts-path "$consumer_artifacts" "${properties[@]}"
jit_output="$consumer_artifacts/bin/Tl.PackageConsumer/release"
[[ "$("$jit_output/Tl.PackageConsumer")" == "7" ]]

cache_log="$stage/Tl.PackageConsumer.cache.log"
dotnet build "$consumer" -c Release --no-restore --artifacts-path "$consumer_artifacts" "${properties[@]}" | tee "$cache_log"
grep -F "TlGenCompile: cache hit" "$cache_log"

for forbidden in Tl.Gen.dll Tl.Gen.pdb Microsoft.CodeAnalysis.dll Microsoft.CodeAnalysis.CSharp.dll Tl.Compiler.dll Tl.Gen.C.dll; do
    [[ ! -e "$jit_output/$forbidden" ]] || { printf '%s\n' "JIT output contains $forbidden" >&2; exit 2; }
done

dotnet restore "$consumer" -r "$runtime_identifier" -p:PublishAot=true --force --no-cache --source "$output" --source https://api.nuget.org/v3/index.json --artifacts-path "$consumer_artifacts"
dotnet publish "$consumer" -c Release -r "$runtime_identifier" --self-contained true -p:PublishAot=true -p:StripSymbols=true --no-restore --artifacts-path "$consumer_artifacts" -o "$stage/aot" "${properties[@]}"
[[ "$("$stage/aot/Tl.PackageConsumer")" == "7" ]]

for forbidden in Tl.Gen.dll Tl.Gen.pdb Microsoft.CodeAnalysis.dll Microsoft.CodeAnalysis.CSharp.dll Tl.Compiler.dll Tl.Gen.C.dll; do
    [[ ! -e "$stage/aot/$forbidden" ]] || { printf '%s\n' "NativeAOT output contains $forbidden" >&2; exit 2; }
done

tar --format=ustar --mtime="@$source_epoch" --owner=0 --group=0 --numeric-owner --mode=0755 -C "$stage/aot" -cf "$stage/Tl.PackageConsumer-$runtime_identifier.tar" Tl.PackageConsumer
gzip -n -9 "$stage/Tl.PackageConsumer-$runtime_identifier.tar"
cp "$stage/Tl.PackageConsumer-$runtime_identifier.tar.gz" "$output/"
mkdir "$stage/aot-archive-check"
tar -xzf "$output/Tl.PackageConsumer-$runtime_identifier.tar.gz" -C "$stage/aot-archive-check"
[[ "$("$stage/aot-archive-check/Tl.PackageConsumer")" == "7" ]]
generation_report="$(find "$consumer_artifacts/obj/Tl.PackageConsumer/release" -path '*/TlGenCompile/TlGenCompile.report.txt' -print | sort | tail -n 1)"
[[ -n "$generation_report" ]] || { printf '%s\n' "package consumer generation report was not produced" >&2; exit 2; }
cp "$generation_report" "$output/Tl.PackageConsumer.generation-report.txt"

python3 "$root/eng/release_artifacts.py" manifest "$output" "$phase" "$tag" "$version" "$head_commit" "$sdk" "$runtime_identifier"
(cd "$output" && sha256sum --check SHA256SUMS)

printf '%s\n' "release artifacts: $output"
