<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tl.Core/Tl.Core.csproj" />
    <ProjectReference Include="../../src/Tl.Gen.CSharp/Tl.Gen.CSharp.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all"
                      AdditionalProperties="TargetFramework=netstandard2.0"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>
  <Target Name="GenerateRoutingDomain" BeforeTargets="TlGenExport;BeforeCompile;CoreCompile">
    <PropertyGroup>
      <RoutingDomain>$(IntermediateOutputPath)RoutingDomain.g.cs</RoutingDomain>
    </PropertyGroup>
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/GenerateDomain.py&quot; &quot;$(RoutingDomain)&quot;" />
    <ItemGroup>
      <Compile Include="$(RoutingDomain)" />
      <FileWrites Include="$(RoutingDomain)" />
    </ItemGroup>
  </Target>
  <Import Project="../../src/Tl.Gen.CSharp/build/Tl.Gen.CSharp.targets" />
</Project>
