<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Tl.Bake.Bench</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CoreProject Condition="'$(CoreProject)' == ''">../../src/Tl.Core/Tl.Core.csproj</CoreProject>
    <CoreTfm Condition="'$(CoreTfm)' == ''">netstandard2.1</CoreTfm>
    <GlideBuild Condition="'$(GlideBuild)' == ''">true</GlideBuild>
    <DefineConstants Condition="'$(GlideBuild)' == 'true'">$(DefineConstants);GLIDE_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CoreProject)" SetTargetFramework="TargetFramework=$(CoreTfm)" />
    <Compile Include="../../tests/Shared/DomainBaker.cs" Link="Shared/DomainBaker.cs" />
    <ProjectReference Include="../../src/Tl.Gen.CSharp/Tl.Gen.CSharp.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" AdditionalProperties="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>
  <Import Project="../../src/Tl.Gen.CSharp/build/Tl.Gen.CSharp.targets" />
</Project>
