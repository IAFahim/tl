  <ItemGroup>
    <ProjectReference Include="../../src/Tl.Core/Tl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../tests/Shared/DomainBaker.cs" Link="DomainBaker.cs" />
  </ItemGroup>

</Project>
