<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The NativeAOT measurement path for the frozen timelines. This project
       deliberately references NO packages: BenchmarkDotNet cannot be AOT
       published (trim/single-file analysis errors, see docs/benchmarks.md),
       so the arms are measured by the Stopwatch harness in Program.cs
       ("manual harness") instead of BDN. It compiles the same Hooks.cs and
       the same generated frozen fixtures as Dispatch. -->
  <ItemGroup>
    <Compile Include="../Hooks.cs" Link="Hooks.cs" />
    <Compile Include="../Dispatch/Generated/VitalsFrozen.g.cs" Link="Generated/VitalsFrozen.g.cs" />
    <Compile Include="../Dispatch/Generated/Fused16Frozen.g.cs" Link="Generated/Fused16Frozen.g.cs" />
    <Compile Include="../Dispatch/Generated/FrozenHub.g.cs" Link="Generated/FrozenHub.g.cs" />
  </ItemGroup>

  <!-- Same fixture self-heal as Dispatch: regenerate through the Waffle-based
       generator before the first build on a fresh clone. -->
  <Target Name="GenerateFixtures" BeforeTargets="BeforeBuild"
          Condition="'$(SkipFixtureGeneration)' != 'true' and (!Exists('../Dispatch/Generated/Fused256.g.cs') or !Exists('../Dispatch/Generated/Fused4096.g.cs') or !Exists('../Dispatch/Generated/Sparse256.g.cs') or !Exists('../Dispatch/Generated/Sparse4096.g.cs') or !Exists('../Dispatch/Generated/VitalsFrozen.g.cs') or !Exists('../Dispatch/Generated/Fused16Frozen.g.cs') or !Exists('../Dispatch/Generated/FrozenHub.g.cs'))">
    <Exec Command="dotnet run --project $(MSBuildThisFileDirectory)../Generate -c $(Configuration) -- $(MSBuildThisFileDirectory)../.." />
  </Target>
</Project>
