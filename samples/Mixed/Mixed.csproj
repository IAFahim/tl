<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TlGenAssembly>$(MSBuildProjectDirectory)/../../src/Tl.Gen/bin/$(Configuration)/net10.0/Tl.Gen.dll</TlGenAssembly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tl.Core\Tl.Core.csproj" />
    <ProjectReference Include="..\..\src\Tl.Gen\Tl.Gen.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>
  <Import Project="..\..\src\Tl.Gen\build\Tl.Gen.targets" />
</Project>
