<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Play.Core\Play.Core.csproj" />
  </ItemGroup>


  <Target Name="EmbedLiveReferenceAssemblies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_CoreCompileResourceInputs Include="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'Tl.Core'">
        <LogicalName>LiveRef.Tl.Core.dll</LogicalName>
      </_CoreCompileResourceInputs>
    </ItemGroup>
  </Target>

</Project>
