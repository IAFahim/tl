@page "/live"
@using System.Globalization
@using Play
@using Tl
@inject IJSRuntime JS

<div class="page">
    <div class="page-sub">write the README system in C# · the shipped generator binds the consumer · bake the timeline · run Play.Run(byte[] tlb)</div>
    <div class="split-grid split-live">
        <section class="pane pane-code">
            <div class="pane-head">
                <h2>1 · the system (C#)</h2>
                <label class="head-field">sample
                    <select value="@_preset" @onchange="OnPresetChange" disabled="@Busy" aria-label="sample source">
                        <option value="@ReadmePreset">readme · jump arc</option>
                        <option value="@RawPreset">raw binding (advanced)</option>
                    </select>
                </label>
                <button class="primary head-action" @onclick="OnCompile" disabled="@Busy">compile</button>
            </div>
            <LiveEditor @key="@($"code-{_preset}")" RootId="live-code" Language="csharp" Value="@_source"
                        ValueChanged="@OnSourceChanged" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize code and type panes"
             data-before="0" data-after="2" data-min-before="240" data-min-after="200"></div>

        <section class="pane pane-types">
            <div class="pane-head">
                <h2>2 · type data (JSON)</h2>
                <span class="pane-note">tlb --json shape</span>
            </div>
            <LiveEditor @ref="_typeEditor" RootId="live-types" Language="json" Value="" ReadOnly="true" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize type and timeline panes"
             data-before="2" data-after="4" data-min-before="200" data-min-after="240"></div>

        <section class="pane pane-timeline">
            <div class="pane-head">
                <h2>3 · the data (timeline JSON)</h2>
                <button class="primary head-action" @onclick="OnBakeAndRun" disabled="@Busy">bake &amp; run</button>
            </div>
            <LiveEditor @key="@($"timeline-{_preset}")" RootId="live-timeline" Language="json" Value="@_timelineJson"
                        ValueChanged="@OnTimelineChanged" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize timeline and output panes"
             data-before="4" data-after="6" data-min-before="240" data-min-after="260"></div>

        <section class="pane pane-run">
            <div class="pane-head">
                <h2>output</h2>
                <span class="pane-note">the baked bytes arrive as the Run parameter — the browser has no file system</span>
            </div>
            <div class="pane-body">
                @if (_compiling)
                {
                    <p class="muted run-empty">compiling…</p>
                }
                else if (_running)
                {
                    <p class="muted run-empty">baking and running…</p>
                }
                else if (_compile is { Ok: false })
                {
                    <p class="error">compile failed — fix pane 1</p>
                    <pre class="cp-diagnostics">@_compile.Error</pre>
                }
                else if (_bakeError.Length > 0)
                {
                    <p class="error">run failed</p>
                    <pre class="cp-diagnostics">@_bakeError</pre>
                }
                else if (_run is not null)
                {
                    <pre class="run-console">@string.Join("\n", _run.Console)</pre>
                    <p class="muted run-stats">@($"compiled in {_compile!.CompileMs.ToString(CultureInfo.InvariantCulture)} ms · baked: {_bakeStats} · checksum {_run.Checksum.ToString(CultureInfo.InvariantCulture)}")</p>
                }
                else if (_compile is { Ok: true })
                {
                    <p class="muted run-empty">@($"compiled in {_compile.CompileMs.ToString(CultureInfo.InvariantCulture)} ms — now bake and run")</p>
                }
                else
                {
                    <p class="muted run-empty">a consumer implements ITrack&lt;TTrack, TClip&gt;; compiling with the shipped tl generator registers it through a generated module initializer. Play.Run(byte[] tlb) owns the playback loop — your Console.WriteLine lands here. compile, then bake &amp; run.</p>
                }
            </div>
        </section>
    </div>
</div>

@code
{
    const string ReadmePreset = "readme";
    const string RawPreset = "raw";

    string _preset = ReadmePreset;
    string _source = LiveAuthoring.DefaultSource;
    string _timelineJson = LiveAuthoring.DefaultTimelineJson;
    string _bakeError = "";
    string _bakeStats = "";
    LiveCompile? _compile;
    LiveRun? _run;
    bool _compiling;
    bool _running;

    bool Busy => _compiling || _running;

    LiveEditor? _typeEditor;

    void OnSourceChanged(string value) => _source = value;

    void OnTimelineChanged(string value) => _timelineJson = value;

    void OnPresetChange(ChangeEventArgs e)
    {
        if (Busy) return;
        _preset = e.Value?.ToString() ?? ReadmePreset;
        (_source, _timelineJson) = _preset == RawPreset
            ? (LiveAuthoring.RawBindingSource, LiveAuthoring.RawBindingTimelineJson)
            : (LiveAuthoring.DefaultSource, LiveAuthoring.DefaultTimelineJson);
        _compile = null;
        _run = null;
        _bakeError = "";
        _bakeStats = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("play.wireSplitters");
    }

    async Task OnCompile()
    {
        _compiling = true;
        _compile = null;
        _run = null;
        _bakeError = "";
        await InvokeAsync(StateHasChanged);
        await Task.Run(() => _compile = LiveAuthoring.Compile(_source));
        if (_compile is { Ok: true } && _typeEditor is not null)
            await _typeEditor.SetReadonlyValueAsync(LiveAuthoring.TypeJson(_compile.Assembly!));
        _compiling = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task OnBakeAndRun()
    {
        if (_compile is not { Ok: true })
        {
            _bakeError = "compile pane 1 first";
            _run = null;
            StateHasChanged();
            return;
        }
        _running = true;
        _bakeError = "";
        _run = null;
        await InvokeAsync(StateHasChanged);
        await Task.Run(() =>
        {
            var (bytes, error) = LiveAuthoring.Bake(_compile.Assembly!, _timelineJson);
            if (bytes.Length == 0)
            {
                _bakeError = error;
                return;
            }
            _bakeStats = LiveAuthoring.BakeStats(bytes);
            try
            {
                _run = LiveAuthoring.Run(_compile.Assembly!, bytes);
            }
            catch (Exception ex)
            {
                _bakeError = ex.Message;
            }
        });
        _running = false;
        await InvokeAsync(StateHasChanged);
    }
}
