@page "/live"
@using System.Globalization
@using Play
@using Tl
@inject IJSRuntime JS

<div class="page">
    <div class="page-sub">write the C# pair · get the type JSON · author the timeline JSON · bake and run</div>
    <div class="split-grid split-live">
        <section class="pane pane-code">
            <div class="pane-head">
                <h2>1 · code (C#)</h2>
                <button class="primary head-action" @onclick="OnCompile">compile</button>
            </div>
            <LiveEditor @ref="_codeEditor" RootId="live-code" Language="csharp" Value="@_source"
                        ValueChanged="@OnSourceChanged" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize code and type panes"
             data-before="0" data-after="2" data-min-before="240" data-min-after="200"></div>

        <section class="pane pane-types">
            <div class="pane-head">
                <h2>2 · type data (JSON)</h2>
                <span class="pane-note">tlb --json shape</span>
            </div>
            <LiveEditor @ref="_typeEditor" RootId="live-types" Language="json" Value="" ReadOnly="true" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize type and timeline panes"
             data-before="2" data-after="4" data-min-before="200" data-min-after="240"></div>

        <section class="pane pane-timeline">
            <div class="pane-head">
                <h2>3 · timeline JSON</h2>
                <button class="primary head-action" @onclick="OnBakeAndRun">bake &amp; run</button>
            </div>
            <LiveEditor @ref="_timelineEditor" RootId="live-timeline" Language="json" Value="@_timelineJson"
                        ValueChanged="@OnTimelineChanged" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize timeline and output panes"
             data-before="4" data-after="6" data-min-before="240" data-min-after="260"></div>

        <section class="pane pane-run">
            <div class="pane-head">
                <h2>output</h2>
                <label class="head-field">rows <input type="number" min="1" max="16" step="1" value="@Inv(_rows)" @onchange="OnRowsChange" /></label>
                <label class="head-field">ticks <input type="number" min="1" max="256" step="1" value="@Inv(_ticks)" @onchange="OnTicksChange" /></label>
            </div>
            <div class="pane-body">
                @if (_compiling)
                {
                    <p class="muted">compiling…</p>
                }
                else if (_running)
                {
                    <p class="muted">baking and running…</p>
                }
                else if (_compile is { Ok: false })
                {
                    <p class="error">compile failed — fix pane 1</p>
                    <pre class="cp-diagnostics">@_compile.Error</pre>
                }
                else if (_bakeError.Length > 0)
                {
                    <p class="error">bake failed</p>
                    <pre class="cp-diagnostics">@_bakeError</pre>
                }
                else if (_run is not null)
                {
                    <p class="muted">@($"compiled in {_compile!.CompileMs.ToString(CultureInfo.InvariantCulture)} ms · baked: {_bakeStats} · moved {_run.Moved} · skipped {_run.Skipped} · checksum {_run.Checksum.ToString(CultureInfo.InvariantCulture)}")</p>
                }
                else if (_compile is { Ok: true })
                {
                    <p class="muted">@($"compiled in {_compile.CompileMs.ToString(CultureInfo.InvariantCulture)} ms")</p>
                }
                else
                {
                    <p class="muted run-empty">a track implements IBlend&lt;TClip&gt;; a public static parameterless Run() registers the consumer. compile, then bake &amp; run — half the ticks forward, half backward, through the real movement law. Your Console.WriteLine and the run results land here.</p>
                }
                @if (_run?.Console.Length > 0)
                {
                    <pre class="run-console">@string.Join("\n", _run.Console)</pre>
                }
            </div>
        </section>
    </div>
</div>

@code
{
    string _source = LiveAuthoring.DefaultSource;
    string _timelineJson = LiveAuthoring.DefaultTimelineJson;
    string _bakeError = "";
    string _bakeStats = "";
    LiveCompile? _compile;
    LiveRun? _run;
    bool _compiling;
    bool _running;
    int _rows = 8;
    int _ticks = 41;

    LiveEditor? _codeEditor;
    LiveEditor? _typeEditor;
    LiveEditor? _timelineEditor;

    static string Inv(int value) => value.ToString(CultureInfo.InvariantCulture);

    void OnSourceChanged(string value) => _source = value;

    void OnTimelineChanged(string value) => _timelineJson = value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("play.wireSplitters");
    }

    async Task OnCompile()
    {
        _compiling = true;
        _compile = null;
        _run = null;
        _bakeError = "";
        await InvokeAsync(StateHasChanged);
        await Task.Run(() => _compile = LiveAuthoring.Compile(_source));
        if (_compile is { Ok: true } && _typeEditor is not null)
            await _typeEditor.SetReadonlyValueAsync(LiveAuthoring.TypeJson(_compile.Assembly!));
        _compiling = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task OnBakeAndRun()
    {
        if (_compile is not { Ok: true })
        {
            _bakeError = "compile pane 1 first";
            _run = null;
            StateHasChanged();
            return;
        }
        _running = true;
        _bakeError = "";
        _run = null;
        await InvokeAsync(StateHasChanged);
        await Task.Run(() =>
        {
            var (bytes, error) = LiveAuthoring.Bake(_compile.Assembly!, _timelineJson);
            if (bytes.Length == 0)
            {
                _bakeError = error;
                return;
            }
            _bakeStats = LiveAuthoring.BakeStats(bytes);
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(_timelineJson);
                var duration = 64;
                var looping = true;
                if (document.RootElement.TryGetProperty("duration", out var d) && d.TryGetInt32(out var parsed)) duration = parsed;
                if (document.RootElement.TryGetProperty("loop", out var l) && l.ValueKind == System.Text.Json.JsonValueKind.False) looping = false;
                _run = LiveAuthoring.Run(_compile.Assembly!, bytes, duration, looping, _rows, _ticks);
            }
            catch (Exception ex)
            {
                _bakeError = ex.Message;
            }
        });
        _running = false;
        await InvokeAsync(StateHasChanged);
    }

    void OnRowsChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) _rows = Math.Clamp(value, 1, 16);
    }

    void OnTicksChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) _ticks = Math.Clamp(value, 1, 256);
    }
}
