@page "/live"
@using System.Globalization
@using Play
@using Tl
@implements IDisposable
@inject IJSRuntime JS

<div class="page">
    <div class="live-bar">
        <button class="primary run-action" @onclick="RunNow" disabled="@Busy" aria-keyshortcuts="Control+Enter Meta+Enter">
            @if (Busy)
            {
                <text>running…</text>
            }
            else
            {
                <span aria-hidden="true">▶</span>
                <text> run</text>
            }
        </button>
        <label class="bar-field">examples
            <select value="@_preset" @onchange="OnPresetChange" disabled="@Busy" aria-label="example gallery">
                @foreach (var example in Examples.All)
                {
                    <option value="@example.Id">@example.Label</option>
                }
            </select>
        </label>
        <span class="bar-note">@Description · ctrl+enter runs · baked bytes arrive as the Run parameter — the browser has no file system</span>
    </div>
    <div class="split-grid split-live" data-persist="tl-split-live">
        <section class="pane pane-code">
            <div class="pane-head">
                <h2>1 · system (C#)</h2>
            </div>
            <LiveEditor @key="@($"code-{_preset}")" RootId="live-code" Language="csharp" Value="@_source"
                        ValueChanged="@OnSourceChanged" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize code and type panes"
             data-before="0" data-after="2" data-min-before="240" data-min-after="200"></div>

        <section class="pane pane-types">
            <div class="pane-head">
                <h2>2 · type data</h2>
                <span class="pane-note">tlb --json shape</span>
            </div>
            <LiveEditor @ref="_typeEditor" RootId="live-types" Language="json" Value="" ReadOnly="true" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize type and timeline panes"
             data-before="2" data-after="4" data-min-before="200" data-min-after="240"></div>

        <section class="pane pane-timeline">
            <div class="pane-head">
                <h2>3 · data (timeline JSON)</h2>
            </div>
            <LiveEditor @key="@($"timeline-{_preset}")" RootId="live-timeline" Language="json" Value="@_timelineJson"
                        ValueChanged="@OnTimelineChanged" ClassName="editor-fill" />
        </section>

        <div class="splitter splitter-x" role="separator" aria-orientation="vertical" tabindex="0"
             aria-label="resize timeline and result panes"
             data-before="4" data-after="6" data-min-before="240" data-min-after="260"></div>

        <section class="pane pane-run">
            <div class="pane-head">
                <h2>result</h2>
            </div>
            <div class="pane-body">
                @if (Busy)
                {
                    <p class="muted run-empty">running…</p>
                }
                else if (_compile is { Ok: false })
                {
                    <p class="error run-failed">compile failed — fix pane 1</p>
                    <pre class="cp-diagnostics">@_compile.Error</pre>
                }
                else if (_runError.Length > 0)
                {
                    <p class="error run-failed">run failed</p>
                    <pre class="cp-diagnostics">@_runError</pre>
                }
                else if (_run is not null)
                {
                    <pre class="run-console">@string.Join("\n", _run.Console)</pre>
                    <p class="muted run-stats">@($"compiled in {_compile!.CompileMs.ToString(CultureInfo.InvariantCulture)} ms · baked: {_bakeStats} · checksum {_run.Checksum.ToString(CultureInfo.InvariantCulture)}")</p>
                }
                else
                {
                    <p class="muted run-empty">add a public static Run(byte[] tlb) — run compiles, bakes and calls it; its Console.WriteLine lands here. Run(byte[][] tlbs) receives every timeline when the data pane holds a JSON array.</p>
                }
            </div>
        </section>
    </div>
</div>

@code
{
    string _preset = Examples.Readme.Id;
    string _source = LiveAuthoring.DefaultSource;
    string _timelineJson = LiveAuthoring.DefaultTimelineJson;
    string _compiledSource = "";
    string _runError = "";
    string _bakeStats = "";
    LiveCompile? _compile;
    LiveRun? _run;
    bool _running;
    LiveEditor? _typeEditor;
    DotNetObjectReference<Live>? _self;

    Example Current => Examples.Of(_preset);

    string Description => Current.Description;

    bool Busy => _running;

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("play.disposeRunKey");
        _self?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("play.wireRunKey", _self);
        }
        await JS.InvokeVoidAsync("play.wireSplitters");
    }

    void OnSourceChanged(string value) => _source = value;

    void OnTimelineChanged(string value) => _timelineJson = value;

    void OnPresetChange(ChangeEventArgs e)
    {
        if (Busy) return;
        var example = Examples.Of(e.Value?.ToString() ?? Examples.Readme.Id);
        _preset = example.Id;
        _source = example.Source;
        _timelineJson = example.TimelineJson;
        _compiledSource = "";
        _compile = null;
        _run = null;
        _runError = "";
        _bakeStats = "";
    }

    [JSInvokable]
    public Task OnRunKey() => RunNow();

    async Task RunNow()
    {
        if (Busy) return;
        _running = true;
        _run = null;
        _runError = "";
        _bakeStats = "";
        await InvokeAsync(StateHasChanged);
        string? typeJson = null;
        await Task.Run(() =>
        {
            if (_compiledSource != _source || _compile is not { Ok: true })
            {
                _compile = LiveAuthoring.Compile(_source);
                _compiledSource = _compile.Ok ? _source : "";
            }
            if (_compile is not { Ok: true }) return;
            typeJson = LiveAuthoring.TypeJson(_compile.Assembly!);
            var (packages, error) = LiveAuthoring.BakeAll(_compile.Assembly!, _timelineJson);
            if (packages.Length == 0)
            {
                _runError = error;
                return;
            }
            _bakeStats = LiveAuthoring.BakeStats(packages);
            try
            {
                _run = LiveAuthoring.Run(_compile.Assembly!, packages);
            }
            catch (Exception ex)
            {
                _runError = ex.Message;
            }
        });
        if (typeJson is not null && _typeEditor is not null)
            await _typeEditor.SetReadonlyValueAsync(typeJson);
        _running = false;
        await InvokeAsync(StateHasChanged);
    }
}
