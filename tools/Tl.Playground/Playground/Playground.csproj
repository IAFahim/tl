<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Playground</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Play.Core\Play.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Play.Core" />
    <TrimmerRootAssembly Include="Tl.Gen.CSharp" />
    <PresetFile Include="..\presets\*.json" />
  </ItemGroup>

  <Target Name="CopyPresetFilesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(PresetFile)" DestinationFolder="$(PublishDir)wwwroot\presets" />
  </Target>


  <Target Name="EmbedLiveReferenceAssemblies" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_CoreCompileResourceInputs Include="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'Tl.Core'">
        <LogicalName>LiveRef.Tl.Core.dll</LogicalName>
      </_CoreCompileResourceInputs>
    </ItemGroup>
  </Target>

</Project>
