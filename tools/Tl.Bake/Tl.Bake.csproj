<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tlb</ToolCommandName>
    <PackageOutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</PackageOutputPath>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Bake</PackageId>
    <Authors>IAFahim</Authors>
    <Description>tlb: deterministic JSON-to-TLB1 timeline baker with watch mode, metadata stripping, content cache, and size reports.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>timeline;baker;tlb;cli;dotnet-tool;deterministic</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v1.0.0-alpha.9: emits TLB1 v3 assets (24-byte slot rows, trackIndex at byte 6) and validates that JSON input is UTF-8 with a located diagnostic. Assets baked by earlier alphas are rejected at load; update the tool and re-bake.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pack-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tl.Gen.Tlb\Tl.Gen.Tlb.csproj" />
  </ItemGroup>

</Project>
