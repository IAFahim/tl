<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tlb</ToolCommandName>
    <PackageOutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</PackageOutputPath>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Bake</PackageId>
    <Authors>IAFahim</Authors>
    <Description>tlb: deterministic JSON-to-TLB1 timeline baker with watch mode, metadata stripping, content cache, and size reports.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>timeline;baker;tlb;cli;dotnet-tool;deterministic</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v1.0.0: first complete stable release. API settlement with no compatibility aliases: the consumer method Execute is now OnActive, Step is now Advance, and the typed Apply/Advance overloads live on the Timeline pair surface (the Lane facade is removed). Playback floors receipted on every host shape and CPU tier: shared-clock crowds 0.08 ns/row, per-entity calls 0.80 ns forward, non-AVX2 tiers 0.48 ns via the kernel tier ladder and flat record arena, bit-exact across AVX2, Vector128, and scalar. Bakes dispatch by discovered signature through the IBake marker; the live playground handles arbitrary valid authoring. Pair-typed folding is pair-isolated: Timeline&lt;TTrack,TClip&gt; measures and plays only its own pair, never another pair's consumers. OnActive with no gameplay parameters registers a dispatch-only consumer, fired per row at the position's tick by the no-output Apply(indices, positions, forward) overload.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pack-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tl.Gen.Tlb\Tl.Gen.Tlb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
  </ItemGroup>

</Project>
