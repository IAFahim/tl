<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tlbake</ToolCommandName>
    <PackageOutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</PackageOutputPath>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Bake</PackageId>
    <Authors>IAFahim</Authors>
    <Description>tlbake: deterministic JSON-to-TLB1 timeline baker with metadata stripping, content cache, and size reports.</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>timeline;baker;tlb;cli;dotnet-tool;deterministic</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v1.0.0-alpha.7: fused parse+populate bakes 5.9x faster with identical diagnostics, --json introspects the authoring schema (schemaVersion 1), and --watch re-bakes on save; the retired kernel lane removes --kernel (bake, --json, --watch, --strip, --cache, --report).</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pack-readme.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tl.Gen.Tlb\Tl.Gen.Tlb.csproj" />
  </ItemGroup>

</Project>
