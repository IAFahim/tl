<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Version>$(TlVersion)</Version>
    <PackageId>Tl.Analyzers</PackageId>
    <Authors>IAFahim</Authors>
    <Description>Edit-time Roslyn analyzer for chained TimelineGeneration.Run calls: rejects invalid id fragments (TLGEN85) and consumer filters that cannot match a global::-qualified name (TLGEN86).</Description>
    <PackageProjectUrl>https://github.com/IAFahim/tl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/IAFahim/tl</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>timeline;ecs;burst;unity;dotnet;deterministic;baked-assets;analyzer</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v2.0.1: first release. TLGEN85 (error) rejects a literal id that is not a non-empty ASCII identifier fragment; TLGEN86 (warning) rejects literal consumer filter entries missing the global:: qualification. Mirrors the TLGEN82-84 chained-generation diagnostics at edit time.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Properties\AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="Properties\AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers\dotnet\cs" Visible="false" />
  </ItemGroup>

</Project>
